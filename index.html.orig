            <div class="custom-chip-row" id="customSubjChips">
              <button class="c-chip active" data-val="physics" onclick="this.classList.toggle('active')">⚛️ Physics</button>
              <button class="c-chip active" data-val="chemistry" onclick="this.classList.toggle('active')">⚗️ Chemistry</button>
              <button class="c-chip active" data-val="botany" onclick="this.classList.toggle('active')">🌿 Botany</button>
              <button class="c-chip active" data-val="zoology" onclick="this.classList.toggle('active')">🐾 Zoology</button>
