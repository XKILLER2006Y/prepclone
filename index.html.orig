              <button class="c-chip active" data-val="all" onclick="selectSingleChip(this, '#customFocusChips')">All NCERT Topics</button>
              <button class="c-chip" data-val="weak" onclick="selectSingleChip(this, '#customFocusChips')">🎯 Target Weak Areas</button>
              <button class="c-chip" data-val="pyq" onclick="selectSingleChip(this, '#customFocusChips')">⭐ PYQs Only (2010–2025)</button>
            </div>
          </div>
          <div class="custom-cbt-field">
            <div class="custom-cbt-label">3. Question Count</div>
            <div class="custom-chip-row" id="customCountChips">
              <button class="c-chip" data-val="15" onclick="selectSingleChip(this, '#customCountChips')">15 Qs</button>
              <button class="c-chip" data-val="30" onclick="selectSingleChip(this, '#customCountChips')">30 Qs</button>
              <button class="c-chip active" data-val="45" onclick="selectSingleChip(this, '#customCountChips')">45 Qs</button>
              <button class="c-chip" data-val="90" onclick="selectSingleChip(this, '#customCountChips')">90 Qs</button>
              <button class="c-chip" data-val="180" onclick="selectSingleChip(this, '#customCountChips')">180 Qs</button>
            </div>
          </div>
          <div class="custom-cbt-field">
            <div class="custom-cbt-label">4. Timer Mode</div>
            <div class="custom-chip-row" id="customTimerChips">
              <button class="c-chip active" data-val="timed" onclick="selectSingleChip(this, '#customTimerChips')">⏱ Timed (1 min/Q)</button>
              <button class="c-chip" data-val="untimed" onclick="selectSingleChip(this, '#customTimerChips')">♾️ Untimed Practice</button>
            </div>
          </div>
        </div>
        <div style="display:flex;justify-content:flex-end">
          <button id="btnLaunchCustomCbt" class="btn-primary" style="padding:12px 24px;font-size:15px;font-weight:700" onclick="launchCustomCbtFromStudio()">
            🚀 Generate & Start Custom CBT Test ➔
          </button>
        </div>
      </div>

      <div style="margin-top:40px;background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:24px">
        <h3 style="margin-bottom:14px">Official NTA CBT Question Palette Legend</h3>
        <div class="cbt-legend-grid">
          <div class="cbt-leg-row"><span class="cbt-badge-preview st-answered">1</span> <span><b>Answered</b>: You answered this question.</span></div>
          <div class="cbt-leg-row"><span class="cbt-badge-preview st-not-answered">2</span> <span><b>Not Answered</b>: Visited but not answered.</span></div>
          <div class="cbt-leg-row"><span class="cbt-badge-preview st-not-visited">3</span> <span><b>Not Visited</b>: You have not visited yet.</span></div>
          <div class="cbt-leg-row"><span class="cbt-badge-preview st-marked">4</span> <span><b>Marked for Review</b>: Not answered, marked for review.</span></div>
          <div class="cbt-leg-row"><span class="cbt-badge-preview st-answered-marked">5</span> <span><b>Answered & Marked</b>: Evaluated in final score!</span></div>
        </div>
      </div>
    </section>`;
}

async function startCbtMock(presetKey) {
  const app = document.getElementById('app');
  app.innerHTML = `
    <section class="section" style="text-align:center;padding-top:120px">
      <h2>Preparing CBT Mock Exam...</h2>
      <p style="color:var(--text-secondary);margin-top:8px">Loading question banks from all 10 NCERT textbooks and verified PYQs.</p>
    </section>`;

  await Promise.all(Object.keys(BOOKS).map(b => loadBookData(b)));
  await loadPyq();

  const physicsPool = [];
  const chemPool = [];
  const botanyPool = [];
  const zoologyPool = [];

  Object.entries(questionData).forEach(([bookId, pages]) => {
    pages.forEach(p => {
      p.questions.forEach((q, qidx) => {
        const item = { ...q, bookId, chapter: p.chapter, topic: p.topic, origId: `${bookId}_${p.chapter}_${p.page}_${qidx}` };
        if (bookId.startsWith('physics-')) {
          physicsPool.push(item);
        } else if (bookId.startsWith('chemistry-')) {
          chemPool.push(item);
        } else if (bookId === 'biology-11') {
          if (p.chapter < 13) botanyPool.push(item);
          else zoologyPool.push(item);
        } else if (bookId === 'biology-12') {
          if ([0, 3, 4, 8, 9, 10, 11].includes(p.chapter)) botanyPool.push(item);
          else zoologyPool.push(item);
        }
      });
    });
  });

  (pyqData || []).forEach((q, qidx) => {
    const item = { ...q, bookId: q.book, topic: BOOKS[q.book]?.chapters[q.chapter] || '', origId: `${q.book}_${q.chapter}_pyq_${qidx}` };
    if (q.book.startsWith('physics-')) {
      physicsPool.push(item);
    } else if (q.book.startsWith('chemistry-')) {
      chemPool.push(item);
    } else if (q.book === 'biology-11') {
      if (q.chapter < 13) botanyPool.push(item);
      else zoologyPool.push(item);
    } else if (q.book === 'biology-12') {
      if ([0, 3, 4, 8, 9, 10, 11].includes(q.chapter)) botanyPool.push(item);
      else zoologyPool.push(item);
    }
  });

  const shuffle = arr => arr.sort(() => Math.random() - 0.5);
  shuffle(physicsPool);
  shuffle(chemPool);
  shuffle(botanyPool);
  shuffle(zoologyPool);

  let sections = {};
  let durationMins = 45;
  let title = 'NEET CBT Simulator';

  if (presetKey === 'full-neet') {
    title = 'NEET UG Full Mock Exam (180 Qs)';
    durationMins = 180;
    sections = {
      'Physics': physicsPool.slice(0, 45),
      'Chemistry': chemPool.slice(0, 45),
      'Botany': botanyPool.slice(0, 45),
      'Zoology': zoologyPool.slice(0, 45)
    };
  } else if (presetKey === 'mini-mock') {
    title = 'NEET Mini Mock Exam (45 Qs)';
    durationMins = 45;
    sections = {
      'Physics': physicsPool.slice(0, 15),
      'Chemistry': chemPool.slice(0, 15),
      'Botany': botanyPool.slice(0, 8),
      'Zoology': zoologyPool.slice(0, 7)
    };
  } else if (presetKey === 'physics-drill') {
    title = 'Physics Sectional Test (45 Qs)';
    durationMins = 45;
    sections = { 'Physics': physicsPool.slice(0, 45) };
  } else if (presetKey === 'chem-drill') {
    title = 'Chemistry Sectional Test (45 Qs)';
    durationMins = 45;
    sections = { 'Chemistry': chemPool.slice(0, 45) };
  } else if (presetKey === 'bio-drill') {
    title = 'Biology Sectional Test (45 Qs)';
    durationMins = 45;
    sections = {
      'Botany': botanyPool.slice(0, 23),
      'Zoology': zoologyPool.slice(0, 22)
    };
  } else {
    title = 'Quick Mix Drill (10 Qs)';
    durationMins = 15;
    sections = {
      'Physics': physicsPool.slice(0, 3),
      'Chemistry': chemPool.slice(0, 3),
      'Botany': botanyPool.slice(0, 2),
      'Zoology': zoologyPool.slice(0, 2)
    };
  }

  cbtExamTitle = title;
  cbtSections = Object.keys(sections);
  cbtSectionData = sections;
  cbtActiveSection = cbtSections[0];
  cbtIndexInSection = 0;
  cbtQuestionState = {};
  cbtAnswers = {};
  cbtIsUntimed = false;
  cbtTimeLeft = durationMins * 60;
  cbtTimeUsed = 0;

  cbtSections.forEach(sec => {
    sections[sec].forEach((q, idx) => {
      const qKey = `${sec}_${idx}`;
      cbtQuestionState[qKey] = (sec === cbtActiveSection && idx === 0) ? 'not-answered' : 'not-visited';
      cbtAnswers[qKey] = null;
    });
  });

  stopCbtTimer();
  cbtTimer = setInterval(tickCbt, 1000);
  currentPage = 'cbt-exam';
  render();
  window.scrollTo(0, 0);
}

function stopCbtTimer() {
  if (cbtTimer) { clearInterval(cbtTimer); cbtTimer = null; }
}

function tickCbt() {
  cbtTimeUsed++;
  const el = document.getElementById('cbt-timer-disp');
  if (cbtIsUntimed) {
    if (el) el.textContent = `⏱ ${fmtTime(cbtTimeUsed)} (Untimed)`;
    return;
  }
  cbtTimeLeft--;
  if (el) {
    el.textContent = fmtTime(cbtTimeLeft);
    if (cbtTimeLeft <= 300) el.classList.add('danger');
  }
  if (cbtTimeLeft <= 0) {
    showCbtResult();
  }
}

function switchCbtSection(sec) {
  if (sec === cbtActiveSection) return;
  cbtActiveSection = sec;
  cbtIndexInSection = 0;
  const qKey = `${cbtActiveSection}_${cbtIndexInSection}`;
  if (cbtQuestionState[qKey] === 'not-visited') {
    cbtQuestionState[qKey] = 'not-answered';
  }
  render();
}

function jumpCbt(sec, idx) {
  cbtActiveSection = sec;
  cbtIndexInSection = idx;
  const qKey = `${cbtActiveSection}_${cbtIndexInSection}`;
  if (cbtQuestionState[qKey] === 'not-visited') {
    cbtQuestionState[qKey] = 'not-answered';
  }
  render();
}

function selectCbtOption(optIdx) {
  const qKey = `${cbtActiveSection}_${cbtIndexInSection}`;
  cbtAnswers[qKey] = optIdx;
  document.querySelectorAll('.cbt-opt').forEach((el, i) => {
    if (i === optIdx) el.classList.add('selected');
    else el.classList.remove('selected');
  });
}

function cbtSaveAndNext() {
  const qKey = `${cbtActiveSection}_${cbtIndexInSection}`;
  if (cbtAnswers[qKey] !== null) {
    cbtQuestionState[qKey] = 'answered';
  } else {
    cbtQuestionState[qKey] = 'not-answered';
  }
  advanceCbtNext();
}

function cbtMarkForReviewAndNext() {
  const qKey = `${cbtActiveSection}_${cbtIndexInSection}`;
  if (cbtAnswers[qKey] !== null) {
    cbtQuestionState[qKey] = 'answered-marked';
  } else {
    cbtQuestionState[qKey] = 'marked';
  }
  advanceCbtNext();
}

function cbtClearResponse() {
  const qKey = `${cbtActiveSection}_${cbtIndexInSection}`;
  cbtAnswers[qKey] = null;
  cbtQuestionState[qKey] = 'not-answered';
  document.querySelectorAll('.cbt-opt').forEach(el => el.classList.remove('selected'));
  document.querySelectorAll('.cbt-pbtn.current').forEach(el => el.className = 'cbt-pbtn st-not-answered current');
}

function cbtPrev() {
  if (cbtIndexInSection > 0) {
    cbtIndexInSection--;
    const qKey = `${cbtActiveSection}_${cbtIndexInSection}`;
    if (cbtQuestionState[qKey] === 'not-visited') cbtQuestionState[qKey] = 'not-answered';
    render();
  } else {
    const secIdx = cbtSections.indexOf(cbtActiveSection);
    if (secIdx > 0) {
      cbtActiveSection = cbtSections[secIdx - 1];
      cbtIndexInSection = cbtSectionData[cbtActiveSection].length - 1;
      render();
    }
  }
}

function advanceCbtNext() {
  const curLen = cbtSectionData[cbtActiveSection].length;
  if (cbtIndexInSection < curLen - 1) {
    cbtIndexInSection++;
  } else {
    const secIdx = cbtSections.indexOf(cbtActiveSection);
    if (secIdx < cbtSections.length - 1) {
      cbtActiveSection = cbtSections[secIdx + 1];
      cbtIndexInSection = 0;
    }
  }
  const nextKey = `${cbtActiveSection}_${cbtIndexInSection}`;
  if (cbtQuestionState[nextKey] === 'not-visited') {
    cbtQuestionState[nextKey] = 'not-answered';
  }
  render();
}

function cbtSubmitConfirm() {
  showCbtResult();
}

function showCbtResult() {
  stopCbtTimer();
  let attempted = 0;
  cbtSections.forEach(sec => {
    (cbtSectionData[sec] || []).forEach((_, idx) => {
      const qKey = `${sec}_${idx}`;
      const st = cbtQuestionState[qKey];
      if (cbtAnswers[qKey] !== null && (st === 'answered' || st === 'answered-marked')) {
        attempted++;
      }
    });
  });
  if (attempted > 0) recordDailyGoalAttempt(attempted);
  currentPage = 'cbt-result';
  render();
  window.scrollTo(0, 0);
}

function renderCbtExam() {
  const qList = cbtSectionData[cbtActiveSection] || [];
  const q = qList[cbtIndexInSection];
  if (!q) return '<div class="cbt-container"><h2>Loading question...</h2></div>';

  const qKey = `${cbtActiveSection}_${cbtIndexInSection}`;
  const sel = cbtAnswers[qKey];
  const labels = ['A','B','C','D'];
  const isStarred = getStarredSet().has(q.origId || qKey);

  let stCounts = { answered: 0, notAnswered: 0, notVisited: 0, marked: 0, answeredMarked: 0 };
  qList.forEach((_, i) => {
    const st = cbtQuestionState[`${cbtActiveSection}_${i}`] || 'not-visited';
    if (st === 'answered') stCounts.answered++;
    else if (st === 'not-answered') stCounts.notAnswered++;
    else if (st === 'marked') stCounts.marked++;
    else if (st === 'answered-marked') stCounts.answeredMarked++;
    else stCounts.notVisited++;
  });

  return `
    <div class="cbt-container">
      <div class="cbt-topbar">
        <div class="cbt-top-left">
          <span class="cbt-tag">NEET CBT</span>
          <span style="font-weight:700;font-size:15px">${cbtExamTitle}</span>
        </div>
        <div class="cbt-timer ${!cbtIsUntimed && cbtTimeLeft <= 300 ? 'danger' : ''}" id="cbt-timer-disp">⏱ ${cbtIsUntimed ? fmtTime(cbtTimeUsed) + ' (Untimed)' : fmtTime(cbtTimeLeft)}</div>
      </div>

      <div class="cbt-sections-bar">
        ${cbtSections.map(sec => {
          const count = cbtSectionData[sec].length;
          return `<button class="cbt-sec-tab ${sec === cbtActiveSection ? 'active' : ''}" onclick="switchCbtSection('${sec}')">${sec} <span class="cbt-sec-count">${count}</span></button>`;
        }).join('')}
      </div>

      <div class="cbt-grid">
        <div class="cbt-qpane">
          <div class="cbt-qpane-head">
            <div class="cbt-qno">${cbtActiveSection} — Question ${cbtIndexInSection + 1} of ${qList.length}</div>
            <div style="display:flex;gap:10px;align-items:center">
              <span class="cbt-marks-badge">+4.00, -1.00</span>
              <button class="star-btn ${isStarred ? 'active' : ''}" onclick="toggleStar('${q.origId || qKey}', event)" title="Bookmark question">${isStarred ? '★' : '☆'}</button>
            </div>
          </div>

          <div class="cbt-qtext">${q.question}</div>

          <div class="cbt-options">
            ${q.options.map((opt, i) => `
              <div class="cbt-opt ${sel === i ? 'selected' : ''}" onclick="selectCbtOption(${i})">
                <div class="cbt-opt-circle"></div>
                <div class="cbt-opt-label">${labels[i]}</div>
                <div>${opt}</div>
              </div>
            `).join('')}
          </div>

          <div class="cbt-actions-bar">
            <div class="cbt-btn-grp">
              <button class="btn-primary" onclick="cbtSaveAndNext()">Save & Next</button>
              <button class="btn-secondary" onclick="cbtMarkForReviewAndNext()">Mark for Review & Next</button>
              <button class="btn-secondary" onclick="cbtClearResponse()">Clear Response</button>
            </div>
            <div class="cbt-btn-grp">
              <button class="btn-secondary" onclick="cbtPrev()" ${(cbtIndexInSection === 0 && cbtSections.indexOf(cbtActiveSection) === 0) ? 'disabled style="opacity:0.4;pointer-events:none"' : ''}>← Prev</button>
              <button class="btn-primary" style="background:linear-gradient(135deg,#e53935,#ff6b35)" onclick="cbtSubmitConfirm()">Submit Test</button>
            </div>
          </div>
        </div>

        <div class="cbt-sidebar">
          <div style="font-weight:700;font-size:14px">${cbtActiveSection} Palette</div>
          <div class="cbt-legend-grid">
            <div class="cbt-leg-row"><span class="cbt-badge-preview st-answered">${stCounts.answered}</span> <span>Answered</span></div>
            <div class="cbt-leg-row"><span class="cbt-badge-preview st-not-answered">${stCounts.notAnswered}</span> <span>Not Answered</span></div>
            <div class="cbt-leg-row"><span class="cbt-badge-preview st-not-visited">${stCounts.notVisited}</span> <span>Not Visited</span></div>
            <div class="cbt-leg-row"><span class="cbt-badge-preview st-marked">${stCounts.marked}</span> <span>Review</span></div>
            <div class="cbt-leg-row"><span class="cbt-badge-preview st-answered-marked">${stCounts.answeredMarked}</span> <span>Ans & Marked</span></div>
          </div>

          <div class="cbt-pal-grid">
            ${qList.map((_, i) => {
              const k = `${cbtActiveSection}_${i}`;
              const st = cbtQuestionState[k] || 'not-visited';
              const isCur = i === cbtIndexInSection;
              return `<button class="cbt-pbtn st-${st} ${isCur ? 'current' : ''}" onclick="jumpCbt('${cbtActiveSection}', ${i})">${i + 1}</button>`;
            }).join('')}
          </div>

          <div style="margin-top:auto;padding-top:12px;border-top:1px solid var(--border)">
            <button class="btn-primary" style="width:100%;padding:10px" onclick="cbtSubmitConfirm()">Submit Exam</button>
          </div>
        </div>
      </div>
    </div>`;
}

function renderCbtResult() {
  const secStats = {};
  let totalScore = 0;
  let totalMax = 0;
  let totalAttempted = 0;
  let totalCorrect = 0;
  let totalIncorrect = 0;
  let totalUnattempted = 0;
  const allExamQs = [];

  cbtSections.forEach(sec => {
    let qList = cbtSectionData[sec] || [];
    let secCorrect = 0;
    let secIncorrect = 0;
    let secUnattempted = 0;

    qList.forEach((q, idx) => {
      const qKey = `${sec}_${idx}`;
      const userPick = cbtAnswers[qKey];
      const st = cbtQuestionState[qKey];
      const ci = q.answer.charCodeAt(0) - 65;
      const isAns = (userPick !== null && (st === 'answered' || st === 'answered-marked'));

      if (isAns) {
        if (userPick === ci) {
          secCorrect++;
        } else {
          secIncorrect++;
          recordMistake(q, q.origId || qKey, userPick);
        }
      } else {
        secUnattempted++;
      }

      allExamQs.push({
        ...q,
        section: sec,
        secIdx: idx,
        userPick,
        st,
        isAns,
        isCorrect: isAns && userPick === ci,
        isIncorrect: isAns && userPick !== ci,
        qKey
      });
    });

    const secAttempted = secCorrect + secIncorrect;
    const secMarks = secCorrect * 4 - secIncorrect * 1;
    const secMax = qList.length * 4;
    secStats[sec] = {
      total: qList.length,
      attempted: secAttempted,
      correct: secCorrect,
      incorrect: secIncorrect,
      unattempted: secUnattempted,
      marks: secMarks,
      max: secMax,
      accuracy: secAttempted ? Math.round(secCorrect / secAttempted * 100) : 0
    };

    totalScore += secMarks;
    totalMax += secMax;
    totalAttempted += secAttempted;
    totalCorrect += secCorrect;
    totalIncorrect += secIncorrect;
    totalUnattempted += secUnattempted;
  });

  const totalAccuracy = totalAttempted ? Math.round(totalCorrect / totalAttempted * 100) : 0;
  const pct = totalMax ? Math.round(totalScore / totalMax * 100) : 0;
  const labels = ['A','B','C','D'];

  const filteredQs = allExamQs.filter(q => {
    if (cbtReviewFilter === 'correct') return q.isCorrect;
    if (cbtReviewFilter === 'incorrect') return q.isIncorrect;
    if (cbtReviewFilter === 'unattempted') return !q.isAns;
    return true;
  });

  return `
    <div class="cbt-container" style="max-width:1100px">
      <div class="question-card" style="text-align:center;padding:36px 20px">
        <span class="cbt-tag" style="margin-bottom:12px;display:inline-block">Official Scorecard · NTA Pattern</span>
        <h1 style="font-size:52px;font-weight:800;margin-bottom:4px;color:var(--accent-orange)">
          ${totalScore} <span style="font-size:22px;color:var(--text-muted);font-weight:600">/ ${totalMax}</span>
        </h1>
        <p style="color:var(--text-secondary);font-size:16px;margin-bottom:16px">
          ${totalCorrect} Correct (+${totalCorrect * 4}) · ${totalIncorrect} Incorrect (-${totalIncorrect}) · ${totalUnattempted} Unattempted
        </p>
        <div style="display:flex;gap:20px;justify-content:center;margin-bottom:24px;flex-wrap:wrap">
          <div style="background:var(--bg-secondary);padding:10px 20px;border-radius:10px;border:1px solid var(--border)">
            <div style="font-size:12px;color:var(--text-muted)">Accuracy</div>
            <div style="font-size:20px;font-weight:800;color:var(--accent-green)">${totalAccuracy}%</div>
          </div>
          <div style="background:var(--bg-secondary);padding:10px 20px;border-radius:10px;border:1px solid var(--border)">
            <div style="font-size:12px;color:var(--text-muted)">Time Used</div>
            <div style="font-size:20px;font-weight:800">${fmtTime(cbtTimeUsed)}</div>
          </div>
          <div style="background:var(--bg-secondary);padding:10px 20px;border-radius:10px;border:1px solid var(--border)">
            <div style="font-size:12px;color:var(--text-muted)">Est. Percentile</div>
            <div style="font-size:20px;font-weight:800;color:#00b4d8">${Math.min(99.9, Math.max(10, Math.round((pct * 0.85 + 15) * 10) / 10))}%</div>
          </div>
        </div>

        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
          <button class="btn-primary" onclick="navigate('mix-quiz')">Take Another Mock</button>
          <button class="btn-secondary" onclick="addCbtMistakesToNotebook()">📥 Add All Incorrect to Notebook</button>
          <button class="btn-secondary" onclick="navigate('notebook')">View Mistakes Notebook</button>
        </div>
      </div>

      <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:24px;margin-top:24px">
        <h3 style="font-size:18px;margin-bottom:16px">📊 Section-wise Performance Breakdown</h3>
        <table class="cbt-scorecard-table">
          <thead>
            <tr>
              <th>Section</th>
              <th>Total Qs</th>
              <th>Attempted</th>
              <th>Correct (+4)</th>
              <th>Incorrect (-1)</th>
              <th>Score</th>
              <th>Accuracy</th>
            </tr>
          </thead>
          <tbody>
            ${cbtSections.map(sec => {
              const s = secStats[sec];
              return `
                <tr>
                  <td><b>${sec}</b></td>
                  <td>${s.total}</td>
                  <td>${s.attempted}</td>
                  <td style="color:var(--accent-green)">${s.correct}</td>
                  <td style="color:var(--accent-red)">${s.incorrect}</td>
                  <td><b>${s.marks}</b> / ${s.max}</td>
                  <td>${s.accuracy}%</td>
                </tr>`;
            }).join('')}
            <tr>
              <td><b>TOTAL</b></td>
              <td><b>${allExamQs.length}</b></td>
              <td><b>${totalAttempted}</b></td>
              <td style="color:var(--accent-green)"><b>${totalCorrect}</b></td>
              <td style="color:var(--accent-red)"><b>${totalIncorrect}</b></td>
              <td><b style="color:var(--accent-orange)">${totalScore}</b> / ${totalMax}</td>
              <td><b>${totalAccuracy}%</b></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div style="margin-top:32px">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:18px">
          <h2>📝 Comprehensive Question Solutions & Review (${allExamQs.length})</h2>
          <div class="filter-row" style="margin:0">
            ${[['all',`All (${allExamQs.length})`],['correct',`Correct (${totalCorrect})`],['incorrect',`Incorrect (${totalIncorrect})`],['unattempted',`Unattempted (${totalUnattempted})`]].map(([k, lbl]) => `<button class="fchip ${cbtReviewFilter === k ? 'active' : ''}" onclick="setCbtReviewFilter('${k}', this)">${lbl}</button>`).join('')}
          </div>
        </div>

        ${filteredQs.map((q, i) => {
          const ci = q.answer.charCodeAt(0) - 65;
          const userPick = q.userPick;
          const statusHtml = q.isCorrect
            ? '<span class="q-exam" style="background:rgba(46,125,50,0.15);color:#66bb6a">+4 Correct</span>'
            : q.isIncorrect
            ? '<span class="q-year" style="background:rgba(229,57,53,0.15);color:#ef5350">-1 Incorrect</span>'
            : '<span class="q-type">Unattempted</span>';
          const isStarred = getStarredSet().has(q.origId || q.qKey);

          return `
            <div class="question-card">
              <div class="q-meta">
                <span class="q-type">${q.section} · Q${q.secIdx + 1}</span>
                ${statusHtml}
                ${q.year ? `<span class="q-year">📅 ${q.year}</span>` : ''}
                ${q.ncertRef ? `<span class="q-ncert">📖 ${q.ncertRef}</span>` : ''}
                <button class="star-btn ${isStarred ? 'active' : ''}" onclick="toggleStar('${q.origId || q.qKey}', event)" title="Bookmark question">${isStarred ? '★' : '☆'}</button>
              </div>
              <div class="q-text">${q.question}</div>
              <div class="options" style="pointer-events:none">
                ${q.options.map((opt, j) => `
                  <div class="option ${j === ci ? 'correct' : (j === userPick ? 'wrong' : '')}">
                    <div class="option-label">${labels[j]}</div>
                    <div>${opt}</div>
                  </div>
                `).join('')}
              </div>
              <div class="explanation show">
                <strong>Correct Answer: ${q.answer}</strong>
                ${userPick !== null && userPick !== ci ? `<span style="color:#ef5350;margin-left:10px">(Your pick: ${labels[userPick]})</span>` : ''}
                <br>
                ${q.explanation || 'No detailed explanation provided.'}
                ${q.hint ? `<div style="margin-top:6px;color:var(--accent-orange);font-size:12px">💡 Hint: ${q.hint}</div>` : ''}
              </div>
            </div>`;
        }).join('')}
      </div>
    </div>`;
}

function setCbtReviewFilter(filter, el) {
  cbtReviewFilter = filter;
  render();
}

function addCbtMistakesToNotebook() {
  let count = 0;
  cbtSections.forEach(sec => {
    (cbtSectionData[sec] || []).forEach((q, idx) => {
      const qKey = `${sec}_${idx}`;
      const userPick = cbtAnswers[qKey];
      const st = cbtQuestionState[qKey];
      const ci = q.answer.charCodeAt(0) - 65;
      if ((st === 'answered' || st === 'answered-marked') && userPick !== ci && userPick !== null) {
        recordMistake(q, q.origId || qKey, userPick);
        count++;
      }
    });
  });
  alert(`Added ${count} incorrect questions to your Mistakes Notebook!`);
}

// ============ MISTAKES & BOOKMARKS NOTEBOOK ============
function renderNotebook() {
  const mistakesMap = getMistakes();
  const mistakesList = Object.values(mistakesMap);
  const starredSet = getStarredSet();
  const starredStoredData = (() => {
    try { return JSON.parse(localStorage.getItem('prepclone-starred-data') || '{}'); }
    catch(e) { return {}; }
  })();

  const subjectMatch = (item) => {
    if (notebookFilter === 'all') return true;
    const b = (item.book || item.bookId || '').toLowerCase();
    if (notebookFilter === 'physics') return b.includes('physics');
    if (notebookFilter === 'chemistry') return b.includes('chem');
    if (notebookFilter === 'biology') return b.includes('bio');
    return true;
  };

  const filteredMistakes = mistakesList.filter(subjectMatch);
  const bucketMatch = (item) => {
    if (notebookBucketFilter === 'all') return true;
    const b = item.bucket || getQuestionMistakeBucket(item.qid) || 'unassigned';
    return b === notebookBucketFilter;
  };
  const subjectAndBucketMistakes = filteredMistakes.filter(bucketMatch);

  const starredList = [];
  starredSet.forEach(qid => {
    let q = starredStoredData[qid] || findQuestionById(qid) || mistakesMap[qid];
    if (q) starredList.push({ ...q, qid });
  });
  const filteredStarred = starredList.filter(subjectMatch);

  const labels = ['A','B','C','D'];

  return `
    <div class="notebook-container">
      <div class="notebook-hero">
        <span class="cbt-tag" style="margin-bottom:8px;display:inline-block">📓 Active Recall & Error Log</span>
        <h1>Mistakes & Starred Bookmarks</h1>
        <p>Targeted revision for exam mastery. Incorrect answers are automatically logged here so you can analyze misconceptions and drill them until mastered.</p>
      </div>

      ${(() => {
        const notesList = Object.values(getNotes());
        return `
      <div class="notebook-stats-grid">
        <div class="nb-stat">
          <div class="nb-stat-num">${mistakesList.length}</div>
          <div class="nb-stat-label">Logged Mistakes</div>
        </div>
        <div class="nb-stat">
          <div class="nb-stat-num" style="color:#ffb703">${starredSet.size}</div>
          <div class="nb-stat-label">Starred Questions</div>
        </div>
        <div class="nb-stat">
          <div class="nb-stat-num" style="color:#f59e0b">${notesList.length}</div>
          <div class="nb-stat-label">Personal Notes</div>
        </div>
        <div class="nb-stat">
          <div class="nb-stat-num" style="color:var(--accent-green)">
            ${mistakesList.length + starredSet.size + notesList.length}
          </div>
          <div class="nb-stat-label">Total Revision Vault</div>
        </div>
      </div>
      `;})()}

      <div class="notebook-bar">
        <div class="nb-tab-group">
          <button class="nb-tab ${notebookTab === 'mistakes' ? 'active' : ''}" onclick="setNotebookTab('mistakes')">
            ❌ Mistakes (${mistakesList.length})
          </button>
          <button class="nb-tab ${notebookTab === 'starred' ? 'active' : ''}" onclick="setNotebookTab('starred')">
            ★ Starred (${starredSet.size})
          </button>
          <button class="nb-tab ${notebookTab === 'notes' ? 'active' : ''}" onclick="setNotebookTab('notes')">
            📝 My Notes (${Object.keys(getNotes()).length})
          </button>
        </div>

        <div class="filter-row" style="margin:0">
          ${[['all','All Subjects'],['physics','Physics'],['chemistry','Chemistry'],['biology','Biology']].map(([k, label]) => `<button class="fchip ${notebookFilter === k ? 'active' : ''}" onclick="setNotebookFilter('${k}', this)">${label}</button>`).join('')}
        </div>
      </div>

      ${notebookTab === 'mistakes' ? `
        <div class="filter-row" style="margin:12px 0 16px;gap:6px">
          ${[['all','All Buckets'],['silly','🟡 Silly Mistakes'],['concept','🔴 Concept Traps'],['formula','🟣 Formula Slips'],['guess','⚪ Wild Guesses']].map(([bk, bLabel]) => {
            const cnt = bk === 'all' ? filteredMistakes.length : filteredMistakes.filter(m => (m.bucket || getQuestionMistakeBucket(m.qid)) === bk).length;
            return `<button class="fchip nb-bucket-chip ${notebookBucketFilter === bk ? 'active' : ''}" onclick="setNotebookBucketFilter('${bk}', this)">${bLabel} (${cnt})</button>`;
          }).join('')}
        </div>

        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;flex-wrap:wrap;gap:10px">
          <div>
            ${subjectAndBucketMistakes.length > 0 ? `
              <button class="btn-primary" onclick="startMistakesQuiz('${notebookBucketFilter}')">🎯 Practice ${notebookBucketFilter === 'all' ? 'All' : notebookBucketFilter.toUpperCase()} Mistakes (${subjectAndBucketMistakes.length} Qs)</button>
              <button class="btn-secondary" style="margin-left:8px" onclick="clearAllMistakes()">Clear All</button>
            ` : ''}
          </div>
          <span style="font-size:13px;color:var(--text-secondary)">Showing ${subjectAndBucketMistakes.length} of ${filteredMistakes.length} mistake${filteredMistakes.length === 1 ? '' : 's'}</span>
        </div>

        ${subjectAndBucketMistakes.length === 0 ? `
          <div class="step-card" style="text-align:center;padding:48px 24px">
            <span style="font-size:48px">🎉</span>
            <h3 style="margin:12px 0 8px">No Mistakes in Log!</h3>
            <p style="color:var(--text-secondary);max-width:500px;margin:0 auto 16px">
              ${filteredMistakes.length > 0 ? 'No mistakes found under this specific bucket. Select "All Buckets" to view all logged errors.' : 'As you practice chapters or take quizzes, any question answered incorrectly will be saved here automatically for targeted revision.'}
            </p>
            <button class="btn-primary" onclick="${filteredMistakes.length > 0 ? "setNotebookBucketFilter('all')" : "navigate('books')"}">${filteredMistakes.length > 0 ? 'View All Mistakes ➔' : 'Browse Books & Practice ➔'}</button>
          </div>
        ` : subjectAndBucketMistakes.map(m => {
          const ci = m.answer ? (m.answer.charCodeAt(0) - 65) : 0;
          const userPick = m.userPick !== undefined ? m.userPick : null;
          const isStarred = starredSet.has(m.qid);
          const subjClass = (m.book || '').includes('physics') ? 'physics' : (m.book || '').includes('chem') ? 'chemistry' : 'biology';
          const curBucket = m.bucket || getQuestionMistakeBucket(m.qid);
          return `
            <div class="nb-card" id="nb-${m.qid}">
              <div class="nb-card-meta">
                <div class="nb-tags">
                  <span class="nb-badge ${subjClass}">${subjClass}</span>
                  ${m.book && BOOKS[m.book] ? `<span class="q-type">${BOOKS[m.book].title}</span>` : ''}
                  ${m.chapter !== undefined && m.book && BOOKS[m.book]?.chapters[m.chapter] ? `<span class="q-type">${BOOKS[m.book].chapters[m.chapter]}</span>` : ''}
                  ${m.year ? `<span class="q-year">📅 ${m.year}</span>` : ''}
                  ${curBucket ? `<span class="nb-bucket-tag nb-bucket-${curBucket}">${curBucket.toUpperCase()}</span>` : ''}
                </div>
                <div style="display:flex;gap:8px;align-items:center">
                  <button class="star-btn ${isStarred ? 'active' : ''}" onclick="toggleStar('${m.qid}', event)" title="Bookmark question">${isStarred ? '★' : '☆'}</button>
                  <button class="btn-secondary btn-sm" onclick="resolveMistake('${m.qid}')">✓ Mark Resolved</button>
                </div>
              </div>

              <div class="q-text">${m.question}</div>

              <div class="options" style="pointer-events:none;margin-top:12px">
                ${(m.options || []).map((opt, i) => `
                  <div class="option ${i === ci ? 'correct' : (i === userPick ? 'wrong' : '')}">
                    <div class="option-label">${labels[i]}</div>
                    <div>${opt}</div>
                  </div>
                `).join('')}
              </div>

              ${userPick !== null && userPick !== ci ? `
                <div class="nb-wrong-strip">
                  <span>⚠️ <b>Your previous answer was Option ${labels[userPick]}</b> (Correct is Option ${labels[ci]})</span>
                </div>
              ` : ''}

              <div class="mistake-bucket-bar" style="margin-top:12px">
                <div class="mbb-header">
                  <span class="mbb-label">🏷️ Error Classification:</span>
                  <span style="font-size:11px;color:var(--text-muted)">Change anytime</span>
                </div>
                <div class="mbb-chips">
                  <button type="button" class="bucket-chip bucket-silly ${curBucket === 'silly' ? 'active' : ''}" onclick="setQuestionMistakeBucket('${m.qid}', 'silly', event)">🟡 Silly Mistake</button>
                  <button type="button" class="bucket-chip bucket-concept ${curBucket === 'concept' ? 'active' : ''}" onclick="setQuestionMistakeBucket('${m.qid}', 'concept', event)">🔴 Concept Trap</button>
                  <button type="button" class="bucket-chip bucket-formula ${curBucket === 'formula' ? 'active' : ''}" onclick="setQuestionMistakeBucket('${m.qid}', 'formula', event)">🟣 Formula Slip</button>
                  <button type="button" class="bucket-chip bucket-guess ${curBucket === 'guess' ? 'active' : ''}" onclick="setQuestionMistakeBucket('${m.qid}', 'guess', event)">⚪ Wild Guess</button>
                </div>
              </div>

              <div class="explanation show" style="margin-top:12px">
                <strong>Solution:</strong> ${m.explanation || 'No explanation available.'}
                ${m.hint ? `<div style="margin-top:4px;color:var(--accent-orange);font-size:12px">💡 Hint: ${m.hint}</div>` : ''}
              </div>
            </div>`;
        }).join('')}
      ` : notebookTab === 'starred' ? `
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;flex-wrap:wrap;gap:10px">
          <span style="font-size:13px;color:var(--text-secondary)">Showing ${filteredStarred.length} starred question${filteredStarred.length === 1 ? '' : 's'}</span>
        </div>

        ${filteredStarred.length === 0 ? `
          <div class="step-card" style="text-align:center;padding:48px 24px">
            <span style="font-size:48px">⭐</span>
            <h3 style="margin:12px 0 8px">No Starred Questions!</h3>
            <p style="color:var(--text-secondary);max-width:500px;margin:0 auto 16px">
              Click the star icon (☆) on any question in the chapter reader or test review to bookmark it for high-yield revision.
            </p>
            <button class="btn-primary" onclick="navigate('books')">Browse Books ➔</button>
          </div>
        ` : filteredStarred.map(q => {
          const ci = q.answer ? (q.answer.charCodeAt(0) - 65) : 0;
          const subjClass = (q.book || q.bookId || '').includes('physics') ? 'physics' : (q.book || q.bookId || '').includes('chem') ? 'chemistry' : 'biology';
          return `
            <div class="nb-card" id="nb-${q.qid}">
              <div class="nb-card-meta">
                <div class="nb-tags">
                  <span class="nb-badge ${subjClass}">${subjClass}</span>
                  ${q.book && BOOKS[q.book] ? `<span class="q-type">${BOOKS[q.book].title}</span>` : ''}
                  ${q.chapter !== undefined && q.book && BOOKS[q.book]?.chapters[q.chapter] ? `<span class="q-type">${BOOKS[q.book].chapters[q.chapter]}</span>` : ''}
                  ${q.year ? `<span class="q-year">📅 ${q.year}</span>` : ''}
                </div>
                <button class="star-btn active" onclick="toggleStar('${q.qid}', event)" title="Remove bookmark">★ Starred</button>
              </div>

              <div class="q-text">${q.question}</div>

              <div class="options" style="pointer-events:none;margin-top:12px">
                ${(q.options || []).map((opt, i) => `
                  <div class="option ${i === ci ? 'correct' : ''}">
                    <div class="option-label">${labels[i]}</div>
                    <div>${opt}</div>
                  </div>
                `).join('')}
              </div>

              <div class="explanation show" style="margin-top:12px">
                <strong>Answer: ${q.answer}</strong><br>
                ${q.explanation || ''}
              </div>
            </div>`;
        }).join('')}
      ` : `
        ${(() => {
          const allNotes = Object.values(getNotes());
          const filteredNotes = allNotes.filter(item => {
            if (notebookFilter === 'all') return true;
            const b = (item.bookId || item.book || '').toLowerCase();
            if (notebookFilter === 'physics') return b.includes('physics');
            if (notebookFilter === 'chemistry') return b.includes('chem');
            if (notebookFilter === 'biology') return b.includes('bio');
            return true;
          });

          return `
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;flex-wrap:wrap;gap:10px">
              <span style="font-size:13.5px;color:var(--text-secondary)">
                Personal NCERT textbook annotations and study mnemonics (${filteredNotes.length} notes)
              </span>
              <div>
                ${filteredNotes.length > 0 ? `
                  <button class="btn-secondary" onclick="exportMyNotes()"><span style="margin-right:4px">🖨️</span> Export / Print Notes</button>
                ` : ''}
              </div>
            </div>

            ${filteredNotes.length === 0 ? `
              <div class="step-card" style="text-align:center;padding:48px 24px">
                <span style="font-size:48px">📝</span>
                <h3 style="margin:12px 0 8px">No Notes in Log!</h3>
                <p style="color:var(--text-secondary);max-width:500px;margin:0 auto 16px">
                  Click the <b>✏️ Note</b> button beside any NCERT textbook paragraph while studying chapters to attach personal notes, teacher mnemonics, or tricky concepts.
                </p>
                <button class="btn-primary" onclick="navigate('books')">Browse Books & Study ➔</button>
              </div>
            ` : `
              <div class="nb-notes-grid">
                ${filteredNotes.map(n => `
                  <div class="nb-note-item" id="nb-note-${n.id}">
                    <div>
                      <div class="nb-note-item-meta">
                        <span><b>${n.bookTitle || n.bookId || 'NCERT Book'}</b> · Ch ${n.chapterIdx !== undefined ? n.chapterIdx + 1 : 1}, Pg ${n.pageNum || 1}</span>
                        <span>${new Date(n.updatedAt || Date.now()).toLocaleDateString()}</span>
                      </div>
                      <div class="nb-note-item-para">"${escapeHtml((n.paraSnippet || '').slice(0, 140))}..."</div>
                      <div class="nb-note-item-text">${escapeHtml(n.content)}</div>
                    </div>
                    <div style="display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--border-color);padding-top:10px;margin-top:10px">
                      <button class="btn-primary btn-sm" onclick="jumpToNoteParagraph('${n.bookId}', ${n.chapterIdx || 0}, ${n.pageNum || 1}, '${n.id}')">
                        📖 Open in NCERT ➔
                      </button>
                      <button class="nsn-btn" style="color:#ef4444" onclick="removeParaNote('${n.id}')">Delete</button>
                    </div>
                  </div>
                `).join('')}
              </div>
            `}
          `;
        })()}
      `}
    </div>`;
}

let notebookBucketFilter = 'all';

function setNotebookBucketFilter(bucket, el) {
  notebookBucketFilter = bucket;
  render();
}

function setNotebookTab(tab) {
  notebookTab = tab;
  render();
}

function setNotebookFilter(filter, el) {
  notebookFilter = filter;
  render();
}

function startMistakesQuiz(bucket) {
  let mistakes = Object.values(getMistakes());
  const curBucket = bucket || notebookBucketFilter;
  if (curBucket && curBucket !== 'all') {
    mistakes = mistakes.filter(m => (m.bucket || getQuestionMistakeBucket(m.qid)) === curBucket);
  }
  if (notebookFilter !== 'all') {
    mistakes = mistakes.filter(m => {
      const b = (m.book || m.bookId || '').toLowerCase();
      if (notebookFilter === 'physics') return b.includes('physics');
      if (notebookFilter === 'chemistry') return b.includes('chem');
      if (notebookFilter === 'biology') return b.includes('bio');
      return true;
    });
  }
  if (mistakes.length === 0) {
    alert('No mistakes logged matching this filter yet!');
    return;
  }
  quizQuestions = mistakes.map(m => ({
    question: m.question,
    options: m.options,
    answer: m.answer,
    explanation: m.explanation,
    hint: m.hint,
    difficulty: m.difficulty,
    exam: m.exam,
    year: m.year,
    ncertRef: m.ncertRef,
    ncertPara: m.ncertPara,
    bookId: m.book,
    chapter: m.chapter,
    topic: m.book && BOOKS[m.book] ? BOOKS[m.book].chapters[m.chapter] : 'Mistakes Revision',
    origId: m.qid
  })).sort(() => Math.random() - 0.5);

  quizIndex = 0;
  quizAnswers = new Array(quizQuestions.length).fill(null);
  quizTimeLeft = quizQuestions.length * 90;
  quizTimeUsed = 0;
  stopQuizTimer();
  stopCbtTimer();
  quizTimer = setInterval(tickQuiz, 1000);
  currentPage = 'quiz';
  render();
  window.scrollTo(0, 0);
}

// ============ NAVIGATION ============
function navigate(page) {
  stopQuizTimer();
  stopCbtTimer();
  if (page === 'quiz') {
    startQuiz();
    window.scrollTo(0, 0);
    return;
  }
  currentPage = page;
  currentBook = null;
  render();
  window.scrollTo(0, 0);
}

function openBook(bookId) {
  stopQuizTimer();
  stopCbtTimer();
  currentBook = bookId;
  currentPage = 'book';
  render();
  window.scrollTo(0, 0);
}

function openChapter(chapterIdx) {
  stopQuizTimer();
  stopCbtTimer();
  currentChapter = chapterIdx;
  currentPageNum = 1;
  currentPage = 'chapter';
  renderChapter();
  window.scrollTo(0, 0);
}

function updateNav() {
  document.querySelectorAll('.nav-links a').forEach(a => {
    a.classList.remove('active');
    if (a.dataset.nav === currentPage || 
        (currentPage === 'book' && a.dataset.nav === 'books') ||
        (currentPage === 'chapter' && a.dataset.nav === 'books') ||
        (currentPage === 'mix-quiz' && a.dataset.nav === 'mix-quiz') ||
        (currentPage === 'cbt-exam' && a.dataset.nav === 'mix-quiz') ||
        (currentPage === 'cbt-result' && a.dataset.nav === 'mix-quiz') ||
        (currentPage === 'analytics' && a.dataset.nav === 'analytics') ||
        (currentPage === 'flashcards' && a.dataset.nav === 'flashcards') ||
        (currentPage === 'notebook' && a.dataset.nav === 'notebook')) {
      a.classList.add('active');
    }
  });
}

// ============ AUDIO & SOUND EFFECTS ============
let audioCtx = null;
function getAudioContext() {
  if (!audioCtx && (window.AudioContext || window.webkitAudioContext)) {
    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  }
  if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
  return audioCtx;
}

function playTone(type) {
  if (localStorage.getItem('prepclone-sound') === 'off') return;
  try {
    const ctx = getAudioContext();
    if (!ctx) return;
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.connect(gain);
    gain.connect(ctx.destination);
    const now = ctx.currentTime;

    if (type === 'click') {
      osc.type = 'sine';
      osc.frequency.setValueAtTime(440, now);
      gain.gain.setValueAtTime(0.03, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);
      osc.start(now);
      osc.stop(now + 0.05);
    } else if (type === 'correct') {
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(523.25, now);
      osc.frequency.setValueAtTime(659.25, now + 0.08);
      gain.gain.setValueAtTime(0.05, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);
      osc.start(now);
      osc.stop(now + 0.22);
    } else if (type === 'marker') {
      osc.type = 'sine';
      osc.frequency.setValueAtTime(320, now);
      osc.frequency.exponentialRampToValueAtTime(540, now + 0.15);
      gain.gain.setValueAtTime(0.04, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.18);
      osc.start(now);
      osc.stop(now + 0.18);
    }
  } catch (e) {}
}

function toggleSound() {
  const cur = localStorage.getItem('prepclone-sound') || 'on';
  const next = cur === 'on' ? 'off' : 'on';
  localStorage.setItem('prepclone-sound', next);
  const btn = document.getElementById('soundBtn');
  if (btn) {
    btn.textContent = next === 'on' ? '🔔' : '🔕';
    btn.classList.toggle('muted', next === 'off');
    btn.title = next === 'on' ? 'Sound effects enabled' : 'Sound effects muted';
  }
}

// ============ STUDY STREAK TRACKER ============
function recordStudyActivity() {
  try {
    const today = new Date().toISOString().slice(0, 10);
    const raw = JSON.parse(localStorage.getItem('prepclone-streak') || '{}');
    const activeDays = new Set(raw.activeDays || []);
    let currentStreak = raw.currentStreak || 0;
    let bestStreak = raw.bestStreak || 0;
    const lastDate = raw.lastDate;

    if (!activeDays.has(today)) {
      activeDays.add(today);
      if (lastDate) {
        const last = new Date(lastDate);
        const cur = new Date(today);
        const diffDays = Math.round((cur - last) / (1000 * 60 * 60 * 24));
        if (diffDays === 1) {
          currentStreak++;
        } else if (diffDays > 1) {
          currentStreak = 1;
        }
      } else {
        currentStreak = 1;
      }
      bestStreak = Math.max(bestStreak, currentStreak);
      localStorage.setItem('prepclone-streak', JSON.stringify({
        currentStreak,
        bestStreak,
        lastDate: today,
        activeDays: [...activeDays]
      }));
    }
  } catch (e) {}
}

