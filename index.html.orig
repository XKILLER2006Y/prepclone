let currentFcIdx = 0;
let currentFcFilter = 'all';

function renderFlashcards() {
  const srsData = JSON.parse(localStorage.getItem('prepclone-flashcards') || '{}');
  const now = Date.now();

  const filtered = HIGH_YIELD_FLASHCARDS.filter(c => {
    if (currentFcFilter === 'all') return true;
    if (currentFcFilter === 'due') {
      const item = srsData[c.id];
      return !item || item.nextReview <= now;
    }
    return c.subject.toLowerCase() === currentFcFilter.toLowerCase();
  });

  if (currentFcIdx >= filtered.length) currentFcIdx = 0;
  const card = filtered[currentFcIdx] || HIGH_YIELD_FLASHCARDS[0];
  const dueCount = HIGH_YIELD_FLASHCARDS.filter(c => {
    const item = srsData[c.id];
    return !item || item.nextReview <= now;
  }).length;

  return `
    <div class="flashcards-container">
      <div class="fc-header">
        <div class="crumbs"><a href="javascript:void(0)" onclick="navigate('home')">Home</a> · Flashcards</div>
        <h1 style="margin-top:12px">⚡ NCERT High-Yield Active Recall Deck</h1>
        <p style="color:var(--text-secondary);font-size:14px">
          Tap card to flip between Question and NCERT Answer. Use Spaced Repetition to cement definitions & formulas into long-term memory.
        </p>
      </div>

      <div class="fc-filters">
        <button class="fc-chip ${currentFcFilter === 'all' ? 'active' : ''}" onclick="setFcFilter('all')">All Cards (${HIGH_YIELD_FLASHCARDS.length})</button>
        <button class="fc-chip ${currentFcFilter === 'due' ? 'active' : ''}" onclick="setFcFilter('due')">⏰ Due for Review (${dueCount})</button>
        <button class="fc-chip ${currentFcFilter === 'physics' ? 'active' : ''}" onclick="setFcFilter('physics')">⚛️ Physics</button>
        <button class="fc-chip ${currentFcFilter === 'chemistry' ? 'active' : ''}" onclick="setFcFilter('chemistry')">🧪 Chemistry</button>
        <button class="fc-chip ${currentFcFilter === 'biology' ? 'active' : ''}" onclick="setFcFilter('biology')">🌿 Biology</button>
      </div>

      <div class="fc-scene" onclick="flipCurrentFlashcard()">
        <div class="flashcard" id="activeFlashcard">
          <!-- FRONT -->
          <div class="fc-face fc-front">
            <div class="fc-top-meta">
              <span class="fc-subject-badge">${card.subject}</span>
              <span class="fc-chap-name">${card.chapter}</span>
              <span style="font-size:12px;color:var(--text-muted)">Card ${currentFcIdx + 1}/${filtered.length}</span>
            </div>
            <div class="fc-center">
              <div style="font-size:13px;font-weight:700;color:var(--accent-orange);margin-bottom:8px">CONCEPT CHALLENGE</div>
              <div class="fc-prompt-title">${card.prompt}</div>
            </div>
            <div class="fc-tap-hint">👆 Click anywhere on card or press [Space] to Flip</div>
          </div>

          <!-- BACK -->
          <div class="fc-face fc-back">
            <div class="fc-top-meta">
              <span class="fc-subject-badge" style="background:var(--accent-orange);color:#fff">NCERT VERBATIM ANSWER</span>
              <span class="fc-chap-name">${card.title}</span>
              <span style="font-size:12px;color:var(--text-muted)">Card ${currentFcIdx + 1}/${filtered.length}</span>
            </div>
            <div class="fc-center">
              <div class="fc-ans-title">${card.answer.replace(/\n/g, '<br>')}</div>
              <div class="fc-ans-exp">${card.exp}</div>
            </div>
            <div class="fc-tap-hint">Rate your recall below to schedule next review:</div>
          </div>
        </div>
      </div>

      <!-- SRS Controls -->
      <div class="srs-actions-bar">
        <button class="srs-btn srs-again" onclick="rateFlashcard('${card.id}', 1)" title="Failed recall - Review tomorrow">🔴 Again (+1d)</button>
        <button class="srs-btn srs-hard" onclick="rateFlashcard('${card.id}', 3)" title="Difficult recall - Review in 3 days">🟠 Hard (+3d)</button>
        <button class="srs-btn srs-good" onclick="rateFlashcard('${card.id}', 7)" title="Good recall - Review in 7 days">🟢 Good (+7d)</button>
        <button class="srs-btn srs-easy" onclick="rateFlashcard('${card.id}', 14)" title="Effortless recall - Review in 14 days">🔵 Easy (+14d)</button>
      </div>

      <div style="display:flex;justify-content:space-between;align-items:center;margin-top:28px">
        <button class="btn-secondary" onclick="prevFlashcard()" ${currentFcIdx === 0 ? 'disabled style="opacity:0.5"' : ''}>← Previous Card</button>
        <button class="btn-secondary" onclick="shuffleFlashcards()">🔀 Shuffle</button>
        <button class="btn-primary" onclick="nextFlashcard()" ${currentFcIdx >= filtered.length - 1 ? 'disabled style="opacity:0.5"' : ''}>Next Card →</button>
      </div>
    </div>`;
}

function flipCurrentFlashcard() {
  const card = document.getElementById('activeFlashcard');
  if (card) {
    card.classList.toggle('is-flipped');
    playTone('click');
  }
}

function rateFlashcard(cardId, intervalDays) {
  playTone('correct');
  try {
    const srsData = JSON.parse(localStorage.getItem('prepclone-flashcards') || '{}');
    srsData[cardId] = {
      interval: intervalDays,
      nextReview: Date.now() + (intervalDays * 24 * 60 * 60 * 1000),
      lastReviewed: Date.now()
    };
    localStorage.setItem('prepclone-flashcards', JSON.stringify(srsData));
    recordStudyActivity();
  } catch (e) {}

  const card = document.getElementById('activeFlashcard');
  if (card) card.classList.remove('is-flipped');
  setTimeout(() => {
    currentFcIdx++;
    render();
  }, 200);
}

function setFcFilter(f) {
  currentFcFilter = f;
  currentFcIdx = 0;
  render();
}

function nextFlashcard() {
  currentFcIdx++;
  render();
}

function prevFlashcard() {
  if (currentFcIdx > 0) currentFcIdx--;
  render();
}

function shuffleFlashcards() {
  for (let i = HIGH_YIELD_FLASHCARDS.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [HIGH_YIELD_FLASHCARDS[i], HIGH_YIELD_FLASHCARDS[j]] = [HIGH_YIELD_FLASHCARDS[j], HIGH_YIELD_FLASHCARDS[i]];
  }
  currentFcIdx = 0;
  render();
}

// ============ ENTERPRISE ANALYTICS DASHBOARD ============
function renderAnalytics() {
  const progress = JSON.parse(localStorage.getItem('prepclone-progress') || '[]');
  const rawMistakes = getMistakes();
  const mistakes = Array.isArray(rawMistakes) ? rawMistakes : Object.values(rawMistakes);
  const cbtHistory = JSON.parse(localStorage.getItem('prepclone-cbt-history') || '[]');
  const streak = JSON.parse(localStorage.getItem('prepclone-streak') || '{"currentStreak":1,"bestStreak":1,"activeDays":[]}');

  const totalAttempted = progress.length;
  const totalMistakes = mistakes.length;
  const correctCount = Math.max(0, totalAttempted - totalMistakes);
  const overallAccuracy = totalAttempted ? Math.round((correctCount / totalAttempted) * 100) : 0;
  
  let predictedScore = 0;
  if (cbtHistory.length) {
    const sum = cbtHistory.reduce((a, b) => a + (b.totalScore || 0), 0);
    predictedScore = Math.round(sum / cbtHistory.length);
  } else {
    const base = Math.min(300, totalAttempted * 1.5);
    predictedScore = totalAttempted ? Math.round(base + (overallAccuracy / 100 * 420)) : 180;
  }
  predictedScore = Math.min(720, Math.max(0, predictedScore));
  const percentile = Math.min(99.9, Math.max(20, Math.round((predictedScore / 720) * 100 * 10) / 10));

  let pAtt = 0, pErr = 0;
  let cAtt = 0, cErr = 0;
  let bAtt = 0, bErr = 0;
  let zAtt = 0, zErr = 0;

  progress.forEach(qid => {
    if (qid.includes('physics')) pAtt++;
    else if (qid.includes('chemistry')) cAtt++;
    else if (qid.includes('biology-11') || qid.includes('biology-12')) {
      const ch = parseInt((qid.split('_')[1] || '0'), 10);
      if ([0, 1, 2, 4, 10, 11, 12, 13, 14].includes(ch)) bAtt++;
      else zAtt++;
    }
  });

  mistakes.forEach(m => {
    const qid = m.qid || '';
    if (qid.includes('physics')) pErr++;
    else if (qid.includes('chemistry')) cErr++;
    else if (qid.includes('biology')) {
      const ch = parseInt((qid.split('_')[1] || '0'), 10);
      if ([0, 1, 2, 4, 10, 11, 12, 13, 14].includes(ch)) bErr++;
      else zErr++;
    }
  });

  const getAcc = (att, err) => att ? Math.round(((att - err) / att) * 100) : 75;
  const pAcc = pAtt ? getAcc(pAtt, pErr) : 0;
  const cAcc = cAtt ? getAcc(cAtt, cErr) : 0;
  const bAcc = bAtt ? getAcc(bAtt, bErr) : 0;
  const zAcc = zAtt ? getAcc(zAtt, zErr) : 0;

  const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const today = new Date();
  const past7 = [];
  for (let i = 6; i >= 0; i--) {
    const d = new Date();
    d.setDate(today.getDate() - i);
    const dateStr = d.toISOString().slice(0, 10);
    const dayName = days[d.getDay()];
    const isActive = (streak.activeDays || []).includes(dateStr) || i === 0;
    past7.push({ dayName, dateStr, isActive, dayNum: d.getDate() });
  }

  const effortHistory = JSON.parse(localStorage.getItem('prepclone-effort-dna') || '[]');
  const bioRecords = effortHistory.filter(r => r.subject === 'biology');
  const chemRecords = effortHistory.filter(r => r.subject === 'chemistry');
  const physRecords = effortHistory.filter(r => r.subject === 'physics');

  const calcAvg = (arr, def) => arr.length ? Math.round(arr.reduce((s, r) => s + r.elapsed, 0) / arr.length) : def;
  const avgBio = calcAvg(bioRecords, 28);
  const avgChem = calcAvg(chemRecords, 52);
  const avgPhys = calcAvg(physRecords, 74);

  const totalTracked = Math.max(1, effortHistory.length);
  const optimalCount = effortHistory.filter(r => r.rating === 'optimal').length;
  const moderateCount = effortHistory.filter(r => r.rating === 'moderate').length;
  const timesinkCount = effortHistory.filter(r => r.rating === 'timesink').length;
  const rushedCount = effortHistory.filter(r => r.rating === 'rushed').length;

  const pctOpt = Math.round((optimalCount / totalTracked) * 100) || 68;
  const pctMod = Math.round((moderateCount / totalTracked) * 100) || 18;
  const pctSink = Math.round((timesinkCount / totalTracked) * 100) || 9;
  const pctRush = Math.round((rushedCount / totalTracked) * 100) || 5;

  return `
    <div class="analytics-container">
      <div class="analytics-hero">
        <div class="crumbs"><a href="javascript:void(0)" onclick="navigate('home')">Home</a> · Learning Analytics</div>
        <div class="ph-row" style="margin-top:12px">
          <h1>📊 Performance & NEET Readiness Dashboard</h1>
          <button class="btn-secondary" onclick="window.print()" style="display:inline-flex;align-items:center;gap:6px">
            <span>🖨️</span> Print / Save Report
          </button>
        </div>
        <p style="color:var(--text-secondary);font-size:14px;margin-top:6px">
          Real-time analytics computed 100% locally from your practice sessions, mistakes, and CBT mock exam history.
        </p>
      </div>

      <div class="analytics-kpi-grid">
        <div class="kpi-card">
          <div class="kpi-val accent">${predictedScore} <span style="font-size:16px;color:var(--text-muted)">/ 720</span></div>
          <div class="kpi-lbl">Predicted NEET Score</div>
          <div class="kpi-sub">Est. Percentile: <b>${percentile}th</b></div>
        </div>
        <div class="kpi-card">
          <div class="kpi-val green">${overallAccuracy}%</div>
          <div class="kpi-lbl">Overall Accuracy</div>
          <div class="kpi-sub">${correctCount} correct of ${totalAttempted} attempted</div>
        </div>
        <div class="kpi-card">
          <div class="kpi-val blue">${totalAttempted} <span style="font-size:16px;color:var(--text-muted)">/ 7,136</span></div>
          <div class="kpi-lbl">Curriculum Progress</div>
          <div class="kpi-sub">${Math.round((totalAttempted / 7136) * 100)}% of total question bank covered</div>
        </div>
        <div class="kpi-card">
