// ============ OFFICIAL NCERT SOURCES (verified) ============
// Chapter PDFs live on ncert.nic.in — pattern checked per book:
// kebo101 (Bio XI Ch1), lebo101 (Bio XII Ch1), kech101/kech201-202 (Chem XI),
// lech101/lech201 (Chem XII), keph101/keph201 (Phys XI), leph101/leph201 (Phys XII).
// Part-II books restart numbering at x01.
if (typeof window.pdfjsLib !== 'undefined') {
  pdfjsLib.GlobalWorkerOptions.workerSrc = 'vendor/pdfjs/pdf.worker.min.js';
}

const NCERT = {
  'biology-11':        { code: 'kebo', base: 101, reader: 'https://ncert.nic.in/textbook.php?kebo1=0-19' },
  'biology-12':        { code: 'lebo', base: 101, reader: 'https://ncert.nic.in/textbook.php?lebo1=0-13' },
  'chemistry-11-part-1': { code: 'kech', base: 101, reader: 'https://ncert.nic.in/textbook.php?kech1=0-6' },
  'chemistry-11-part2':  { code: 'kech', base: 201, reader: 'https://ncert.nic.in/textbook.php?kech2=0-3' },
  'chemistry-12-part-1': { code: 'lech', base: 101, reader: 'https://ncert.nic.in/textbook.php?lech1=0-5' },
  'chemistry-12-part-2': { code: 'lech', base: 201, reader: 'https://ncert.nic.in/textbook.php?lech2=0-5' },
  'physics-11-part-1':   { code: 'keph', base: 101, reader: 'https://ncert.nic.in/textbook.php?keph1=0-7' },
  'physics-11-part-2':   { code: 'keph', base: 201, reader: 'https://ncert.nic.in/textbook.php?keph2=0-7' },
  'physics-12-part-1':   { code: 'leph', base: 101, reader: 'https://ncert.nic.in/textbook.php?leph1=0-8' },
  'physics-12-part-2':   { code: 'leph', base: 201, reader: 'https://ncert.nic.in/textbook.php?leph2=0-6' }
};
const ncertPdf = (bookId, idx) =>
  `https://ncert.nic.in/textbook/pdf/${NCERT[bookId].code}${NCERT[bookId].base + idx}.pdf`;

// ============ DRIVE MIRROR (Google Drive preview embeds — verified chapter mapping) ============
// Source: Tiwari Academy NCERT books index (2026-27 rationalised edition), chapter titles match ours 1:1.
const DRIVE = {
  'biology-11': ['1fvsdo7oiV77ky65Xd4eEH6ZkzFial9g9','19zQ0uyoimge0R9zZM1DbDAEgejbITwo9','14VKVHbL3yxclMsSfU2fc29LhUX0q_4FP','1zyyKzU43hCwQWqIQVJF6ueCHc24nG4D9','10JVspOq2XQqp1UlfwYtZwZyy9CQq3hL6','1xHfeKlNFapAcFalF3eiSdjTrEFuTNkrU','1USzUHXbv7c-BZaMNtCvqSi4uM29exoF-','1_h1kWr7Tkhm8Q56S7ht1NJK0plMMvyFQ','1dxBcWB4P3WUcOm1wODoFABikpEJF3r6i','1NEUx3Ubcn2yg18nJZ1j-xpB5lJAnWqLf','1Eqf9TPWISpTS_Tn12sNTewKYirmxJpzB','1dTE6Hkq23dg3fD0mxMU2Rm9n2y5Q8g41','1jGFy47KBCoPfr2B214CeN81xEJDaa3nP','1md0GE6ZRODzGjrTwy0BfDM_slUbUUZZc','1JRxcOx0mD4W-6_r_snKFTruz2SlAP2ft','1iy1gL5658NCeA5Q80WOsL-wOBIlpXKNk','17tF6_xH8C2PZNPqCg5y_x2i3dXgWSa91','1RWi_krgMPdo5kl6K-04BmAE0lxBPeUwd','14cnd7dDWV_9AqgSkbJWoxDJYVgXdmFyA'],
  'biology-12': ['1i-HofUO-jg_4zmSZCH1X3XZCpBvTD5g8','1c2RogWk7DBDEVt_mZCFTXbslxEOotZ0O','1APRizLZcdaJMCvmS1m_25Znv2gcplQ2a','1L-cc1nSRoHXnkz693aI5Jssp2_q50-LY','1BgPBh9dEvvbRj18aPnBjS9A9TGn-yXfc','1RQW-htV_1VvpN5XPwAp27clJuwX4X1NV','1UeFNkTsd9I21zjW5WHVBhihtphOV5wIR','1xOy0-ris2WhBWW4GSpwAC73xNxPJA_7E','13c2I-ysmpRyNzTtXQDioSG5sf1dPAS5W','1mBETPBQEMBGGqqvFBYvykPvUT3dNY4qn','1zhIcXd0ZhK2_lbr2YUlZIUvvFhg3Zk8U','1bjJVSkMWN_cYF8TT85O8UrAOXzqMXSRM','1qNM4PDr8dxptGMcYKJGqJO04t2rbLmQD'],
  'chemistry-11-part-1': ['1g2u5Ip_cECSVaJrVS3nLRxZjbIpwGPRu','11b_64T60rTA6i3MZbh1NN-b69V5aIVlX','1thvxushVpuq-t2g5-lVlptlWhaXpaOTl','1DLZKrqRKVuCKDu5omxT7bbp09vr_sGtt','1K5Y2pivwtAmhT05v0cto4DBeJDX23lj6','1JQShi0uyOJ55L3Qcb53Cr13P7cmdIvxs'],
  'chemistry-11-part2': ['1y8yHCy-q_3vTzHv-as41cKaJzMk6qr3h','18_MGR344HiHiA06RGmX9Upc8qDxLFS_K','1QqKFPGPQnxaUB-J8YnDAOm_Cg2C53JKa'],
  'chemistry-12-part-1': ['1-5vdlGWP1ke1fM61O386CQ9qWtfsxBn0','1c8t2dDz-PiGZJQuaN4wPHwUSfcHYnYAC','10TvhfVuGc6oE9re8dLpLBndLfI_FLHxJ','1kDvl7DNc59dEvfE3HVBEaFU7aMLd6lTq','1kAFd7es13D6Rk2pys90a5iqeQU0x2cYQ'],
  'chemistry-12-part-2': ['1n9qBYEchzJi6G09oisFDdIHqmcHntv4c','1TXruu7-2E2KmMr_VbR2OomEqNucGPzqW','1zaU8VexyY4VYSKuTs9x0MOZlb2oroocD','1Ew0yQycmTdjNz1YYfrAKwJLtDM_vP-Im','1GdgZbdIaUHd1UaiDhjuanpwjwYO2w_gW']
};
const PDF_MODES = ['drive', 'native', 'gview'];
const PDF_MODE_LABEL = { drive: 'Drive', native: 'Native', gview: 'Viewer' };
// Drive files confirmed ToS-taken-down (render-verified, one by one)
const DRIVE_DEAD = { 'biology-11': [0, 5, 6, 17], 'biology-12': [2] };
const driveAlive = (bookId, idx) => !(DRIVE_DEAD[bookId] || []).includes(idx);
const driveUrl = (bookId, idx) => `https://drive.google.com/file/d/${DRIVE[bookId][idx]}/preview`;
function getPdfMode() {
  try { const m = localStorage.getItem('prepclone-pdfmode'); if (PDF_MODES.includes(m)) return m; } catch (e) {}
  return 'drive';
}
function pdfSrcFor(mode, bookId, idx) {
  const gview = 'https://docs.google.com/viewer?url=' + encodeURIComponent(ncertPdf(bookId, idx)) + '&embedded=true';
  if (mode === 'gview') return gview;
  if (mode === 'native') return ncertPdf(bookId, idx);
  // drive default; taken-down files fall through to Google viewer
  if (driveAlive(bookId, idx) && DRIVE[bookId] && DRIVE[bookId][idx]) return driveUrl(bookId, idx);
  return gview;
}
window.ncertPdf = ncertPdf;

// ============ OFFICIAL PYQ SOURCES (verified) ============
const PYQS = {
  neet: [
    { name: 'NTA NEET Archive (official)', desc: 'Official question papers released by NTA.', url: 'https://neet.nta.nic.in/archive/' },
    { name: 'NTA NEET Documents (official)', desc: 'Latest papers, keys and bulletins.', url: 'https://neet.nta.nic.in/documents/' },
    { name: 'NEET Papers 2013–2026 (67 PDFs)', desc: 'Free compilation with answer keys.', url: 'https://docs.aglasem.com/org/nta/neet-ug/question-paper' },
    { name: 'NEET Papers 2015–2026 Code-wise', desc: 'All booklet codes with solutions.', url: 'https://medicine.careers360.com/articles/neet-question-paper' }
  ],
  jee: [
    { name: 'NTA JEE Main Documents (official)', desc: 'Official papers, keys and scores.', url: 'https://jeemain.nta.nic.in/documents/' },
    { name: 'NTA JEE Main Archive (official)', desc: 'Older official papers and keys.', url: 'https://jeemain.nta.nic.in/document-category/archive/' },
    { name: 'JEE Main Papers 2016–2026', desc: 'Year-wise papers with solutions.', url: 'https://www.shiksha.com/engineering/articles/jee-main-previous-year-question-paper-blogId-51869' },
    { name: 'NTA Downloads Portal', desc: 'Downloads → Previous years Exam Papers.', url: 'https://nta.ac.in/' }
  ]
};

// ============ STATE ============
let currentPage = 'home';
let currentBook = null;
let currentChapter = 0;
let currentPageNum = 1;
let questionData = {};
let pyqData = null;
let quizQuestions = [];
let quizIndex = 0;
let quizAnswers = [];
let quizTimeLeft = 0;
let quizTimeUsed = 0;
let quizTimer = null;

// CBT Mock State
let cbtExamTitle = '';
let cbtSections = [];
let cbtSectionData = {};
let cbtActiveSection = '';
let cbtIndexInSection = 0;
let cbtQuestionState = {};
let cbtAnswers = {};
let cbtTimeLeft = 0;
let cbtTimeUsed = 0;
let cbtTimer = null;
let cbtIsUntimed = false;
let cbtReviewFilter = 'all';

// Notebook State
let notebookTab = 'mistakes'; // 'mistakes' | 'starred'
let notebookFilter = 'all';   // 'all' | 'physics' | 'chemistry' | 'biology'

// ============ STARRED & MISTAKES STORE ============
function getStarredSet() {
  try {
    return new Set(JSON.parse(localStorage.getItem('prepclone-starred') || '[]'));
  } catch (e) {
    return new Set();
  }
}

function getMistakes() {
  try {
    return JSON.parse(localStorage.getItem('prepclone-mistakes') || '{}');
  } catch (e) {
    return {};
  }
}

function saveMistakes(m) {
  try {
    localStorage.setItem('prepclone-mistakes', JSON.stringify(m));
  } catch (e) {}
  updateMistakesBadge();
}

function updateMistakesBadge() {
  const m = getMistakes();
  const count = Object.keys(m).length;
  const badge = document.getElementById('nav-mistakes-badge');
  if (badge) {
    if (count > 0) {
      badge.textContent = count;
      badge.style.display = 'inline-block';
    } else {
      badge.style.display = 'none';
    }
  }
}

function toggleStar(qid, event) {
  if (event) { event.stopPropagation(); event.preventDefault(); }
  const s = getStarredSet();
  const isStarred = s.has(qid);
  if (isStarred) {
    s.delete(qid);
  } else {
    s.add(qid);
    const qObj = findQuestionById(qid);
    if (qObj) {
      try {
        const sd = JSON.parse(localStorage.getItem('prepclone-starred-data') || '{}');
        sd[qid] = { ...qObj, qid, timestamp: Date.now() };
        localStorage.setItem('prepclone-starred-data', JSON.stringify(sd));
      } catch (e) {}
    }
  }
  try {
    localStorage.setItem('prepclone-starred', JSON.stringify([...s]));
  } catch (e) {}

  document.querySelectorAll(`.star-btn[data-qid="${qid}"]`).forEach(btn => {
    btn.classList.toggle('active', !isStarred);
    btn.textContent = !isStarred ? '★' : '☆';
    btn.title = !isStarred ? 'Bookmarked' : 'Bookmark / Star question';
  });

  if (currentPage === 'notebook') {
    render();
  }
}

function recordMistake(q, qid, pickedIdx) {
  if (!q) return;
  const m = getMistakes();
  m[qid] = {
    qid,
    question: q.question,
    options: q.options,
    answer: q.answer,
    explanation: q.explanation,
    hint: q.hint,
    difficulty: q.difficulty,
    exam: q.exam,
    year: q.year,
    ncertRef: q.ncertRef,
    ncertPara: q.ncertPara,
    book: q.book || q.bookId || (qid.split('_')[0] || ''),
    chapter: q.chapter !== undefined ? q.chapter : (parseInt(qid.split('_')[1], 10) || 0),
    userPick: pickedIdx,
    timestamp: Date.now()
  };
  saveMistakes(m);
}

function resolveMistake(qid) {
  const m = getMistakes();
  delete m[qid];
  saveMistakes(m);
  if (currentPage === 'notebook') {
    render();
  }
}

function clearAllMistakes() {
  if (confirm('Are you sure you want to clear all recorded mistakes?')) {
    saveMistakes({});
    if (currentPage === 'notebook') render();
  }
}

// ============ 1. MISTAKE CATEGORIZATION BUCKETS ============
function setQuestionMistakeBucket(qid, bucket, event) {
  if (event) event.stopPropagation();
  const m = getMistakes();
  if (m[qid]) {
    m[qid].bucket = bucket;
    saveMistakes(m);
  }
  try {
    const buckets = JSON.parse(localStorage.getItem('prepclone-mistake-buckets') || '{}');
    buckets[qid] = bucket;
    localStorage.setItem('prepclone-mistake-buckets', JSON.stringify(buckets));
  } catch (e) {}

  const bar = document.getElementById(`mbb-${qid}`);
  if (bar) {
    bar.querySelectorAll('.bucket-chip').forEach(c => c.classList.remove('active'));
    const activeChip = bar.querySelector(`.bucket-${bucket}`);
    if (activeChip) activeChip.classList.add('active');
  }
  const nbCard = document.getElementById(`nb-${qid}`);
  if (nbCard) {
    nbCard.querySelectorAll('.bucket-chip').forEach(c => c.classList.remove('active'));
    const activeChip = nbCard.querySelector(`.bucket-${bucket}`);
    if (activeChip) activeChip.classList.add('active');
  }
  playTone('click');
}

function getQuestionMistakeBucket(qid) {
  const m = getMistakes();
  if (m[qid] && m[qid].bucket) return m[qid].bucket;
  try {
    const buckets = JSON.parse(localStorage.getItem('prepclone-mistake-buckets') || '{}');
    if (buckets[qid]) return buckets[qid];
  } catch (e) {}
  return null;
}

// ============ 2. DARWIN EFFORT-DNA PACING ENGINE ============
const questionStartTimes = {};

function startQuestionTimer(qid) {
  if (!questionStartTimes[qid]) {
    questionStartTimes[qid] = Date.now();
  }
}

function recordQuestionPacing(qid, isCorrect) {
  const start = questionStartTimes[qid] || (Date.now() - 15000);
  const elapsed = Math.max(1, Math.round((Date.now() - start) / 1000));
  
  let subject = 'biology';
  if (qid.includes('physics')) subject = 'physics';
  else if (qid.includes('chem')) subject = 'chemistry';
  else if (typeof currentBook !== 'undefined' && currentBook.includes('physics')) subject = 'physics';
  else if (typeof currentBook !== 'undefined' && currentBook.includes('chem')) subject = 'chemistry';

  const target = subject === 'biology' ? 35 : (subject === 'chemistry' ? 60 : 80);
  
  let rating = 'optimal';
  let label = `🟢 ${elapsed}s (Optimal)`;
  let pillClass = 'qt-optimal';

  if (!isCorrect && elapsed < 8) {
    rating = 'rushed';
    label = `⚡ ${elapsed}s (Rushed)`;
    pillClass = 'qt-rushed';
  } else if (elapsed > target * 1.5) {
    rating = 'timesink';
    label = `🔴 ${elapsed}s (Time Sink)`;
    pillClass = 'qt-timesink';
  } else if (elapsed > target) {
    rating = 'moderate';
    label = `🟡 ${elapsed}s (Moderate)`;
    pillClass = 'qt-moderate';
  }

  const pill = document.getElementById(`qtpill-${qid}`);
  if (pill) {
    pill.className = `qt-pacing-pill ${pillClass}`;
    pill.textContent = label;
    pill.style.display = 'inline-flex';
  }
  const timeEl = document.getElementById(`qttime-${qid}`);
  if (timeEl) {
    timeEl.textContent = `${elapsed}s`;
  }

  try {
    const hist = JSON.parse(localStorage.getItem('prepclone-effort-dna') || '[]');
    hist.push({ qid, subject, elapsed, rating, isCorrect: !!isCorrect, target, timestamp: Date.now() });
    if (hist.length > 500) hist.shift();
    localStorage.setItem('prepclone-effort-dna', JSON.stringify(hist));
  } catch (e) {}

  return { elapsed, rating, label, pillClass };
}

// ============ 3. TEXTBOOK QUESTION FOCUS ============
function focusQuestionFromTextbook(qid) {
  let card = document.getElementById(`q-${qid}`);
  if (!card) {
    const allCards = document.querySelectorAll('#chapter-qs .question-card');
    for (const c of allCards) {
      if (c.id.includes(qid)) { card = c; break; }
    }
  }
  if (card) {
    card.scrollIntoView({ behavior: 'smooth', block: 'center' });
    card.classList.add('card-focus-pulse');
    setTimeout(() => card.classList.remove('card-focus-pulse'), 2500);
    playTone('marker');
  }
}

// ============ 4. AUDIO NCERT PODCAST READER ============
let ncertSpeechSynth = null;
let podcastSentences = [];
let currentPodcastIdx = 0;
let isPodcastPlaying = false;
let isPodcastPaused = false;
let podcastRate = 1.0;

function toggleNcertPodcast() {
  if (typeof window !== 'undefined' && 'speechSynthesis' in window) {
    ncertSpeechSynth = window.speechSynthesis;
  }
  if (!ncertSpeechSynth) {
    alert('Web Speech API is not supported in this browser.');
    return;
  }
  if (isPodcastPlaying) {
    stopNcertPodcast();
  } else {
    startNcertPodcast();
  }
}

function extractNcertPageSentences() {
  const container = document.getElementById('ncertReaderView');
  if (!container) return [];
  const paraEls = container.querySelectorAll('.ncert-para-text');
  const items = [];
  paraEls.forEach((el, pi) => {
    const text = el.dataset.origText || el.textContent.trim();
    if (!text) return;
    const sents = text.match(/[^.!?]+[.!?]+(\s|$)/g) || [text];
    sents.forEach((s, si) => {
      const clean = s.trim();
      if (clean.length > 5) {
        items.push({ text: clean, el, paraIdx: pi, sentIdx: si });
      }
    });
  });
  return items;
}

function startNcertPodcast() {
  podcastSentences = extractNcertPageSentences();
  if (!podcastSentences.length) {
    alert('No textbook sentences found to narrate on this page.');
    return;
  }
  currentPodcastIdx = 0;
  isPodcastPlaying = true;
  isPodcastPaused = false;

  const playBtn = document.getElementById('podcastPlayBtn');
  const controls = document.getElementById('podcastControls');
  const playIcon = document.getElementById('podcastPlayIcon');
  const playText = document.getElementById('podcastPlayText');
  const pauseBtn = document.getElementById('podcastPauseBtn');

  if (playBtn) playBtn.classList.add('playing');
  if (controls) controls.style.display = 'inline-flex';
  if (playIcon) playIcon.textContent = '⏹️';
  if (playText) playText.textContent = 'Stop';
  if (pauseBtn) pauseBtn.textContent = '⏸️';

  speakPodcastCurrentSentence();
}

function speakPodcastCurrentSentence() {
  if (!isPodcastPlaying || currentPodcastIdx >= podcastSentences.length) {
    stopNcertPodcast();
    return;
  }
  document.querySelectorAll('.audio-sentence-active').forEach(el => el.classList.remove('audio-sentence-active'));
  const cur = podcastSentences[currentPodcastIdx];
  if (cur && cur.el) {
    cur.el.classList.add('audio-sentence-active');
    cur.el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
  const statusText = document.getElementById('podcastStatusText');
  if (statusText) statusText.textContent = `${currentPodcastIdx + 1}/${podcastSentences.length}`;

  ncertSpeechSynth.cancel();
  const utter = new SpeechSynthesisUtterance(cur.text);
  utter.rate = podcastRate;
  utter.lang = 'en-IN';
  utter.onend = () => {
    if (isPodcastPlaying && !isPodcastPaused) {
      currentPodcastIdx++;
      speakPodcastCurrentSentence();
    }
  };
  utter.onerror = (e) => {
    if (e.error !== 'canceled' && e.error !== 'interrupted') {
      currentPodcastIdx++;
      if (isPodcastPlaying) speakPodcastCurrentSentence();
    }
  };
  ncertSpeechSynth.speak(utter);
}

function togglePodcastPause() {
  if (!isPodcastPlaying) return;
  const pauseBtn = document.getElementById('podcastPauseBtn');
  if (isPodcastPaused) {
    isPodcastPaused = false;
    ncertSpeechSynth.resume();
    if (pauseBtn) pauseBtn.textContent = '⏸️';
  } else {
    isPodcastPaused = true;
    ncertSpeechSynth.pause();
    if (pauseBtn) pauseBtn.textContent = '▶️';
  }
}

function skipPodcastSentence(delta) {
  if (!isPodcastPlaying) return;
  currentPodcastIdx = Math.max(0, Math.min(podcastSentences.length - 1, currentPodcastIdx + delta));
  speakPodcastCurrentSentence();
}

function cyclePodcastSpeed() {
  const speeds = [1.0, 1.25, 1.5, 0.85];
  const idx = speeds.indexOf(podcastRate);
  podcastRate = speeds[(idx + 1) % speeds.length];
  const btn = document.getElementById('podcastSpeedBtn');
  if (btn) btn.textContent = `${podcastRate}x`;
  if (isPodcastPlaying && !isPodcastPaused) {
    speakPodcastCurrentSentence();
  }
}

function stopNcertPodcast() {
  isPodcastPlaying = false;
  isPodcastPaused = false;
  if (ncertSpeechSynth) ncertSpeechSynth.cancel();
  document.querySelectorAll('.audio-sentence-active').forEach(el => el.classList.remove('audio-sentence-active'));
  const playBtn = document.getElementById('podcastPlayBtn');
  const controls = document.getElementById('podcastControls');
  const playIcon = document.getElementById('podcastPlayIcon');
  const playText = document.getElementById('podcastPlayText');
  if (playBtn) playBtn.classList.remove('playing');
  if (controls) controls.style.display = 'none';
  if (playIcon) playIcon.textContent = '🎧';
  if (playText) playText.textContent = 'Listen to Page';
}

// ============ 5. MEMONEET-STYLE CLOZE ACTIVE RECALL ============
let isClozeModeActive = false;

function toggleClozeMode() {
  isClozeModeActive = !isClozeModeActive;
  const btn = document.getElementById('clozeModeBtn');
  const btnText = document.getElementById('clozeBtnText');
  if (btn) btn.classList.toggle('active', isClozeModeActive);
  if (btnText) btnText.textContent = isClozeModeActive ? 'Cloze Active' : 'Cloze Recall';
  applyClozeToNcertPage();
}

function applyClozeToNcertPage() {
  const paraContainers = document.querySelectorAll('#ncertReaderView .ncert-para');
  paraContainers.forEach(container => {
    const p = container.querySelector('.ncert-para-text');
    if (!p) return;
    if (!p.dataset.origText) {
      p.dataset.origText = p.textContent.trim();
    }
    const orig = p.dataset.origText;
    if (!isClozeModeActive) {
      p.innerHTML = escapeHtml(orig);
      return;
    }
    const keytermEl = container.querySelector('.ncert-para-keyterm');
    const specificKey = keytermEl ? keytermEl.textContent.trim() : '';

    const keywords = [
      'Aristotle','Linnaeus','Whittaker','Monera','Protista','Fungi','Plantae','Animalia',
      'chitin','cellulose','peptidoglycan','methanogens','halophiles','thermoacidophiles',
      'heterotrophic','autotrophic','cyanobacteria','mycoplasma','diatoms','dinoflagellates',
      'euglenoids','slime moulds','protozoans','saprophytic','parasitic','symbiotic',
      'lichen','mycorrhiza','ascomycetes','basidiomycetes','phycomycetes','deuteromycetes',
      'virus','viroid','prion','capsid','mitochondria','chloroplast','ribosome','ATP','DNA','RNA',
      'photosynthesis','respiration','glycolysis','Krebs','osmosis','diffusion',
      'growth','reproduction','metabolism','consciousness','biodiversity','nomenclature','identification','classification',
      'taxonomy','systematics','species','genus','family','order','class','phylum','division','kingdom'
    ];
    if (specificKey && specificKey.length > 2) keywords.unshift(specificKey);

    let processed = escapeHtml(orig);
    keywords.forEach(kw => {
      const regex = new RegExp(`\\b(${kw})\\b`, 'gi');
      processed = processed.replace(regex, (match) => {
        return `<span class="cloze-blank" role="button" tabindex="0" data-ans="${escapeHtml(match)}" onclick="revealClozeWord(this)">[ ????? ]</span>`;
      });
    });
    p.innerHTML = processed;
  });
}

function revealClozeWord(el) {
  const ans = el.dataset.ans;
  if (!ans) return;
  el.outerHTML = `<span class="cloze-revealed" role="button" tabindex="0" title="Mastered! Click to re-hide" onclick="hideClozeWord(this, '${escapeHtml(ans)}')">${escapeHtml(ans)}</span>`;
  playTone('marker');
}

function hideClozeWord(el, ans) {
  el.outerHTML = `<span class="cloze-blank" role="button" tabindex="0" data-ans="${escapeHtml(ans)}" onclick="revealClozeWord(this)">[ ????? ]</span>`;
}

function findQuestionById(qid) {
  try {
    const parts = qid.split('_');
    if (parts.length >= 4) {
      const bookId = parts[0];
      const ch = parseInt(parts[1], 10);
      if (parts[2] === 'pyq') {
        const qidx = parseInt(parts[3], 10);
        if (pyqData) {
          const chPyqs = pyqData.filter(p => p.book === bookId && p.chapter === ch);
          if (chPyqs[qidx]) return { ...chPyqs[qidx], book: bookId, chapter: ch };
        }
      } else {
        const page = parseInt(parts[2], 10);
        const qidx = parseInt(parts[3], 10);
        const pages = questionData[bookId];
        if (pages) {
          const pg = pages.find(p => p.chapter === ch && p.page === page);
          if (pg?.questions?.[qidx]) return { ...pg.questions[qidx], book: bookId, chapter: ch };
        }
      }
    }
    if (cbtSectionData) {
      for (const sec of Object.keys(cbtSectionData)) {
        if (qid.startsWith(sec + '_')) {
          const idx = parseInt(qid.replace(sec + '_', ''), 10);
          if (cbtSectionData[sec]?.[idx]) return cbtSectionData[sec][idx];
        }
      }
    }
    if (quizQuestions && quizQuestions.length) {
      const idx = parseInt(qid.replace(/^q-/, ''), 10);
      if (!isNaN(idx) && quizQuestions[idx]) return quizQuestions[idx];
    }
  } catch (e) {}
  return null;
}

// ============ DATA LOADING ============
async function loadBookData(bookId) {
  if (questionData[bookId]) return questionData[bookId];
  try {
    const res = await fetch(`data/${bookId}.json`);
    const data = await res.json();
    questionData[bookId] = data;
    return data;
  } catch(e) {
    console.error('Failed to load', bookId, e);
    return [];
  }
}

async function loadPyq() {
  if (pyqData) return pyqData;
  try {
    const res = await fetch('data/pyq.json');
    pyqData = await res.json();
  } catch(e) {
    console.error('Failed to load PYQs', e);
    pyqData = [];
  }
  return pyqData;
}

// ============ RENDERING ============
function render() {
  const app = document.getElementById('app');
  switch(currentPage) {
    case 'home': app.innerHTML = renderHome(); break;
    case 'books': app.innerHTML = renderBooks(); break;
    case 'book': renderBook(); return;
    case 'chapter': renderChapter(); return;
    case 'quiz': app.innerHTML = renderQuiz(); break;
    case 'quiz-result': app.innerHTML = renderQuizResult(); break;
    case 'mix-quiz': app.innerHTML = renderMixQuizSetup(); break;
    case 'cbt-exam': app.innerHTML = renderCbtExam(); break;
    case 'cbt-result': app.innerHTML = renderCbtResult(); break;
    case 'notebook': app.innerHTML = renderNotebook(); break;
    case 'analytics': app.innerHTML = renderAnalytics(); break;
    case 'flashcards': app.innerHTML = renderFlashcards(); break;
    case 'pyqs': app.innerHTML = renderPyqs(); break;
  }
  updateNav();
  updateMistakesBadge();
}

