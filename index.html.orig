                    <td>${h.accuracy}%</td>
                    <td>${h.sectionScores?.physics ?? '-'}</td>
                    <td>${h.sectionScores?.chemistry ?? '-'}</td>
                    <td>${h.sectionScores?.botany ?? '-'}</td>
                    <td>${h.sectionScores?.zoology ?? '-'}</td>
