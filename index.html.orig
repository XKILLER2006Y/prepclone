function filterBooks(filter, el) {
  document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
  el.classList.add('active');
  document.querySelectorAll('.book-card').forEach(card => {
    const subject = card.dataset.subject;
    const cls = card.dataset.cls;
    const show = filter === 'all' || subject === filter || cls === filter;
    card.style.display = show ? '' : 'none';
  });
}

async function renderBook() {
  const app = document.getElementById('app');
  const book = BOOKS[currentBook];
  const data = await loadBookData(currentBook);
  const pyqs = await loadPyq();
  
  // Group pages by chapter
  const chapterPages = {};
  data.forEach(d => {
    if (!chapterPages[d.chapter]) chapterPages[d.chapter] = [];
    chapterPages[d.chapter].push(d);
  });
  
  app.innerHTML = `
    <div class="page-header">
      <a href="javascript:void(0)" onclick="navigate('books')" style="color:var(--accent-orange);font-size:14px;margin-bottom:12px;display:inline-block">← Back to Books</a>
      <h1>${book.emoji} ${book.title}</h1>
      <p>Class ${book.cls} · NCERT · ${book.chapters.length} chapters · ${data.reduce((s,d) => s + d.questions.length, 0) + pyqs.filter(p => p.book === currentBook).length} questions (incl. PYQs)</p>
      <p style="margin-top:8px"><a href="${NCERT[currentBook].reader}" target="_blank" rel="noopener" style="color:var(--accent-orange);font-size:14px">📕 Read full NCERT textbook (official ncert.nic.in) →</a></p>
    </div>
    <div class="chapter-list">
      ${book.chapters.map((ch, i) => {
        const pages = chapterPages[i] || [];
        const qCount = pages.reduce((s, p) => s + p.questions.length, 0)
          + pyqs.filter(p => p.book === currentBook && p.chapter === i).length;
        let doneCount = 0;
        try {
          const doneSet = new Set(JSON.parse(localStorage.getItem('prepclone-progress') || '[]'));
          doneSet.forEach(id => {
            if (!id.startsWith(currentBook + '_')) return;
            const mm = id.match(/_(\d+)_(?:\d+|pyq)_\d+$/);
            if (mm && Number(mm[1]) === i) doneCount++;
          });
        } catch (e) { /* ignore */ }
        const donePct = qCount ? Math.round(doneCount / qCount * 100) : 0;
        return `
          <div class="chapter-item" role="button" tabindex="0" onclick="openChapter(${i})">
            <div class="chapter-num">${String(i+1).padStart(2,'0')}</div>
            <div class="chapter-info">
              <div class="chapter-name">${ch}</div>
              <div class="chapter-meta">${pages.length} pages · ${qCount} questions · <a href="${ncertPdf(currentBook, i)}" target="_blank" rel="noopener" onclick="event.stopPropagation()" class="pdf-link">📕 NCERT PDF</a></div>
              ${qCount ? `<div class="chap-progress"><div class="chap-progress-fill" style="width:${donePct}%"></div></div>
              <div class="chapter-meta">${doneCount}/${qCount} answered</div>` : ''}
            </div>
            <div class="chapter-arrow">→</div>
          </div>`;
      }).join('')}
    </div>`;
  updateNav();
}

async function renderChapter() {
  const app = document.getElementById('app');
  const book = BOOKS[currentBook];
  const data = await loadBookData(currentBook);
  
  // Get pages for this chapter
  const chapterPages = data.filter(d => d.chapter === currentChapter);
  window.currentChapterPages = chapterPages;
  const pageData = chapterPages.find(d => d.page === currentPageNum);
  const maxPage = chapterPages.length > 0 ? Math.max(...chapterPages.map(d => d.page)) : 1;

  const pyqs = (await loadPyq()).filter(p => p.book === currentBook && p.chapter === currentChapter);
  window.currentChapterPyqs = pyqs;

  // Year breakdown computed live from the PYQ bank — no hardcoded numbers
  const yearCounts = {};
  pyqs.forEach(p => { const k = p.year || 'Untagged'; yearCounts[k] = (yearCounts[k] || 0) + 1; });
  const weightStrip = pyqs.length
    ? `<div class="weight-strip">🎯 <b>${pyqs.length} PYQs</b> in this chapter's bank ${Object.entries(yearCounts).map(([y, n]) => `<span class="wchip">${y} ×${n}</span>`).join('')}</div>`
    : '';
  const visibleQs = [...(pageData?.questions || []), ...(currentPageNum === maxPage ? pyqs : [])];
  const chipCount = (k) => k === 'all' ? visibleQs.length
    : k === 'pyq' ? visibleQs.filter(q => 'book' in q).length
    : visibleQs.filter(q => (q.difficulty || 'Medium').toLowerCase() === k).length;
  const examCount = (k) => k === 'all' ? visibleQs.length
    : visibleQs.filter(q => (q.exam || []).map(e => e.toLowerCase()).includes(k)).length;
  
  const topic = pageData?.topic || book.chapters[currentChapter];
  
  app.innerHTML = `
    <div class="page-header">
      <div class="crumbs"><a href="javascript:void(0)" onclick="navigate('home')">Home</a> · <a href="javascript:void(0)" onclick="openBook('${currentBook}')">${book.title}</a> · ${book.chapters[currentChapter]} · Page ${currentPageNum}</div>
      <div class="ph-row">
        <h1>${book.emoji} ${book.chapters[currentChapter]}</h1>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
          <button class="btn-tool-formula" onclick="toggleFormulaDrawer()" title="NCERT Formulas & Cheat Sheet (Alt+F)">⚡ Formulas</button>
          <button class="btn-secondary btn-sm" onclick="exportRevisionNotes()" title="Export Clean Printable NCERT Revision Sheet">🖨️ Revision Notes</button>
          <div class="page-progress"><span id="pp-text">0/${visibleQs.length}</span><div class="pp-bar"><div class="pp-fill" id="pp-fill"></div></div></div>
        </div>
      </div>
    </div>
    <div class="split-wrap split-on" id="splitWrap">
      <div class="pdf-pane">
        <div class="pdf-bar">
          <div class="pane-view-tabs">
            <button class="pv-tab active" id="tab-reader" onclick="switchLeftPaneView('reader')">📖 NCERT Book</button>
            <button class="pv-tab" id="tab-canvas" onclick="switchLeftPaneView('canvas')">📄 PDF Canvas</button>
            <button class="pv-tab" id="tab-pdf" onclick="switchLeftPaneView('pdf')">🌐 Embed</button>
          </div>
          <span style="display:flex;gap:8px;align-items:center">
            ${currentPageNum > 1 ? `<button class="btn-secondary pdf-navbtn" onclick="goPage(${currentPageNum-1})">←</button>` : ''}
            <span class="page-indicator" style="font-size:12px;color:var(--text-muted)">Pg ${currentPageNum}/${maxPage}</span>
            ${currentPageNum < maxPage ? `<button class="btn-primary pdf-navbtn" onclick="goPage(${currentPageNum+1})">Next →</button>` : ''}
            <a href="${ncertPdf(currentBook, currentChapter)}" target="_blank" rel="noopener" class="pdf-link">Open ↗</a>
            <button class="pdf-toggle pdf-mode" onclick="togglePdfMode()" title="Switch PDF source">${PDF_MODE_LABEL[getPdfMode()]}</button>
            <button class="pdf-toggle" onclick="toggleSplit()">Hide</button>
          </span>
        </div>

        <!-- Interactive Authentic NCERT Textbook Page Sheet Reader -->
        <div class="ncert-reader-view" id="ncertReaderView">
          <div class="ncert-study-toolbar" id="ncertStudyToolbar">
            <div class="nst-left">
              <button class="podcast-play-btn" id="podcastPlayBtn" onclick="toggleNcertPodcast()" title="Listen to NCERT page text with native browser speech synthesis (100% free)">
                <span id="podcastPlayIcon">🎧</span> <span id="podcastPlayText">Listen to Page</span>
              </button>
              <div class="podcast-controls" id="podcastControls" style="display:none">
                <button class="podcast-ctrl-btn" onclick="skipPodcastSentence(-1)" title="Previous sentence">⏮️</button>
                <button class="podcast-ctrl-btn" onclick="togglePodcastPause()" id="podcastPauseBtn" title="Pause / Resume">⏸️</button>
                <button class="podcast-ctrl-btn" onclick="skipPodcastSentence(1)" title="Next sentence">⏭️</button>
                <button class="podcast-speed-btn" onclick="cyclePodcastSpeed()" id="podcastSpeedBtn" title="Audio Speed">1.0x</button>
                <button class="podcast-ctrl-btn" onclick="stopNcertPodcast()" title="Stop Audio">⏹️</button>
                <span class="podcast-status-text" id="podcastStatusText">Ready</span>
              </div>
            </div>
            <div class="nst-right">
              <button class="cloze-mode-btn" id="clozeModeBtn" onclick="toggleClozeMode()" title="Toggle Active Recall Cloze Blanks on NCERT text">
                <span>🧠</span> <span id="clozeBtnText">Cloze Recall</span>
              </button>
            </div>
          </div>

          <div class="ncert-book-sheet">
            <div class="ncert-page-header">
              <div class="ncert-running-head">NCERT · ${(book.subject || book.title).toUpperCase()} · CLASS ${book.classLabel || 'XI'}</div>
              <div class="ncert-page-badge">Page ${currentPageNum} of ${maxPage}</div>
            </div>
            
            <div class="ncert-chapter-banner">
              <div class="ncert-chapter-num-label">CHAPTER ${currentChapter + 1}</div>
              <h2 class="ncert-chapter-title">${book.chapters[currentChapter]}</h2>
            </div>
            
            <div class="ncert-topic-subhead">
              <span class="topic-indicator">§ Topic</span> ${topic}
            </div>

            <div class="ncert-paras-list">
              ${(pageData?.paragraphs || []).map((p, pi) => {
                const qidx = p.qIndex !== undefined ? p.qIndex : pi;
                const qId = `${currentBook}_${currentChapter}_${currentPageNum}_${qidx}`;
                const matchedQ = pageData?.questions?.[qidx];
                const pyqYearTag = matchedQ?.year ? `NEET '${String(matchedQ.year).slice(-2)}` : (matchedQ?.exam?.length ? matchedQ.exam[0] : (p.paraNum % 2 === 0 ? `NEET '${20 + (p.paraNum % 5)}` : ''));
                return `
                ${(() => {
                  const existingNote = getParagraphNote(qId);
                  return `
                  <div class="ncert-para" role="button" tabindex="0" id="ncert-para-${qId}" data-qidx="${qidx}" onclick="focusQuestionCard('${qId}')" title="Click to focus Question ${p.paraNum || (pi + 1)}">
                    <div class="ncert-para-meta">
                      <span class="ncert-para-num">¶ ${p.paraNum || (pi + 1)}</span>
                      <span class="ncert-para-anchor">🎯 Question ${p.paraNum || (pi + 1)} Concept Anchor</span>
                      ${p.keyTerm ? `<span class="ncert-para-keyterm">${p.keyTerm}</span>` : ''}
                      ${pyqYearTag ? `<span class="pyq-inline-pill" onclick="event.stopPropagation(); focusQuestionFromTextbook('${qId}')" title="Appeared in ${pyqYearTag} — Click to focus question">🎯 ${pyqYearTag}</span>` : ''}
                      <button class="ncert-note-btn ${existingNote ? 'has-note' : ''}" onclick="event.stopPropagation(); toggleParaNoteEditor('${qId}')" title="${existingNote ? 'View/Edit Note' : 'Add Note to this paragraph'}">
                        ✏️ ${existingNote ? 'Note Attached' : 'Note'}
                      </button>
                    </div>
                    <p class="ncert-para-text">${p.text}</p>

                    ${existingNote ? `
                      <div class="ncert-sticky-note-card" id="note-card-${qId}">
                        <div class="nsn-header">
                          <span>📝 Personal Note</span>
                          <span style="font-size:10.5px;opacity:0.8">${new Date(existingNote.updatedAt || Date.now()).toLocaleDateString()}</span>
                        </div>
                        <div class="nsn-content">${escapeHtml(existingNote.content)}</div>
                        <div class="nsn-actions">
                          <button class="nsn-btn" onclick="event.stopPropagation(); editParaNote('${qId}')">Edit</button>
                          <button class="nsn-btn" style="color:#ef4444" onclick="event.stopPropagation(); removeParaNote('${qId}')">Delete</button>
                        </div>
                      </div>
                    ` : ''}

                    <div id="note-editor-${qId}" class="ncert-note-editor" style="display:none" onclick="event.stopPropagation()">
                      <textarea class="note-textarea" id="note-textarea-${qId}" placeholder="Write personal note, mnemonic, or tricky concept anchor for this paragraph...">${existingNote ? escapeHtml(existingNote.content) : ''}</textarea>
                      <div style="display:flex;gap:8px;justify-content:flex-end">
                        <button class="btn-ghost" style="padding:4px 10px;font-size:12px" onclick="cancelParaNoteEditor('${qId}')">Cancel</button>
                        <button class="btn-primary" style="padding:4px 12px;font-size:12px" onclick="saveParaNoteFromEditor('${qId}', ${p.paraNum || (pi + 1)})">Save Note</button>
                      </div>
                    </div>
                  </div>
                `})()}
              `;}).join('') || '<p style="color:var(--text-muted)">No textbook content available for this page.</p>'}
            </div>

            ${currentPageNum === maxPage && pyqs.length ? `
              <div class="ncert-pyq-section">
                <div class="ncert-pyq-title">🎯 Previous Year Questions (PYQs) NCERT Anchors</div>
                ${pyqs.map((pq, pi) => `
                  <div class="ncert-para ncert-para-pyq" id="ncert-para-${currentBook}_${currentChapter}_pyq_${pi}" data-qidx="pyq_${pi}" onclick="focusQuestionCard('${currentBook}_${currentChapter}_pyq_${pi}')" title="Click to scroll to PYQ ${pi + 1}">
                    <div class="ncert-para-meta">
                      <span class="ncert-para-num">PYQ ${pi + 1}</span>
                      <span class="ncert-para-anchor">📅 ${pq.year || 'NEET/JEE'} · ${pq.ncertRef || 'Core Theory'}</span>
                    </div>
                    <p class="ncert-para-text">${pq.ncertPara || pq.explanation}</p>
                  </div>
                `).join('')}
              </div>
            ` : ''}

            <div class="ncert-sheet-footer">
              <span class="nsf-left">Official NCERT Textbook Verbatim</span>
              <span class="nsf-center">Page ${currentPageNum}</span>
              <span class="nsf-right">PrepPage Enterprise Edition</span>
            </div>
          </div>
        </div>

        <!-- Native PDF.js Page Canvas Viewer -->
        <div class="ncert-canvas-view" id="ncertCanvasView" style="display:none">
          <div class="canvas-bar">
            <div class="canvas-zoom-controls">
              <button class="btn-secondary btn-sm" onclick="zoomPdfCanvas(-0.15)" title="Zoom Out">－</button>
              <span id="canvasZoomPercent" style="font-size:12px;font-weight:700;color:var(--text-secondary)">100%</span>
              <button class="btn-secondary btn-sm" onclick="zoomPdfCanvas(0.15)" title="Zoom In">＋</button>
              <button class="btn-secondary btn-sm" onclick="fitPdfCanvas()">Fit</button>
            </div>
            <div class="canvas-info-status" id="canvasStatusText">Loading official NCERT page...</div>
          </div>
          <div class="pdf-canvas-scroll" id="pdfCanvasScroll">
            <div class="pdf-canvas-stage" id="pdfCanvasStage">
              <canvas id="pdfCanvas"></canvas>
              <div class="pdf-highlight-overlay" id="pdfHighlightOverlay"></div>
            </div>
          </div>
        </div>

        <iframe class="pdf-frame" loading="lazy" title="NCERT chapter PDF" style="display:none"
          src="${pdfSrcFor(getPdfMode(), currentBook, currentChapter)}"></iframe>
        <div class="pdf-fallback" style="display:none">If the PDF does not load here, use <a href="${ncertPdf(currentBook, currentChapter)}" target="_blank" rel="noopener" class="pdf-link">Open ↗</a></div>
      </div>
      <div class="qa-pane">
    <div class="quiz-container">
      <div class="hpq-head"><span class="hpq-dot"></span> High-Probability Exam Questions</div>
      <div class="exam-row">
        ${[['all','ALL'],['neet','NEET'],['jee','JEE']].map(([k, label], ci) => `<button class="echip${ci === 0 ? ' active' : ''}" data-k="${k}" onclick="setQFilter('exam','${k}',this)">${label} (${examCount(k)})</button>`).join('')}
      </div>
      <h1 class="topic-box">📚 ${topic}</h1>
      ${weightStrip}
      <div class="filter-row">
        ${[['all','All'],['easy','Easy'],['medium','Medium'],['hard','Hard'],['pyq','PYQs']].map(([k, label], ci) => `<button class="fchip${ci === 0 ? ' active' : ''}" data-k="${k}" onclick="setQFilter('diff','${k}',this)">${label} (${chipCount(k)})</button>`).join('')}
      </div>
      <div class="pattern-filter-bar">
        ${[['all','All Patterns'],['mcq','Standard MCQ'],['ar','⚡ Assertion-Reason'],['statement','📋 Statements I & II'],['match','🔗 Match-the-Columns']].map(([k, label], ci) => `<button class="pchip${ci === 0 ? ' active' : ''}" data-k="${k}" onclick="setQFilter('pattern','${k}',this)">${label}</button>`).join('')}
      </div>
      <div id="chapter-qs">
      ${pageData?.questions?.map((q, i) => renderQuestion(q, `${currentBook}_${currentChapter}_${currentPageNum}_${i}`, false, i)).join('') || '<p style="color:var(--text-muted)">No questions available for this page.</p>'}
      ${currentPageNum === maxPage && pyqs.length ? `
        <h2 class="pyq-heading">🎯 Previous Year Questions (${pyqs.length})</h2>
        ${pyqs.map((q, i) => renderQuestion(q, `${currentBook}_${currentChapter}_pyq_${i}`, true, `pyq_${i}`)).join('')}` : ''}
      </div>
      <div class="page-nav" style="margin-top:32px">
        ${currentPageNum > 1 ? `<button class="btn-secondary" onclick="goPage(${currentPageNum-1})">← Previous</button>` : '<span></span>'}
        <span></span>
        ${currentPageNum < maxPage ? `<button class="btn-primary" onclick="goPage(${currentPageNum+1})">Next →</button>` : '<span></span>'}
      </div>
      </div>
    </div>
    </div>`;
  updateNav();
  applySplitPref();
  updatePageProgress();
}

function toggleSplit() {
  const w = document.getElementById('splitWrap');
  const btn = document.querySelector('.pdf-toggle:not(.pdf-mode)');
  const on = w.classList.toggle('split-on');
  w.classList.toggle('split-off', !on);
  if (btn) btn.textContent = on ? 'Hide' : 'PDF';
  try { localStorage.setItem('prepclone-split', on ? 'on' : 'off'); } catch (e) {}
}

function switchLeftPaneView(mode) {
  const reader = document.getElementById('ncertReaderView');
  const canvasView = document.getElementById('ncertCanvasView');
  const frame = document.querySelector('.pdf-frame');
  const fallback = document.querySelector('.pdf-fallback');
  const tabReader = document.getElementById('tab-reader');
  const tabCanvas = document.getElementById('tab-canvas');
  const tabPdf = document.getElementById('tab-pdf');

  if (mode === 'pdf') {
    if (reader) reader.style.display = 'none';
    if (canvasView) canvasView.style.display = 'none';
    if (frame) frame.style.display = 'block';
    if (fallback) fallback.style.display = 'block';
    if (tabReader) tabReader.classList.remove('active');
    if (tabCanvas) tabCanvas.classList.remove('active');
    if (tabPdf) tabPdf.classList.add('active');
    try { localStorage.setItem('prepclone-leftpane-mode', 'pdf'); } catch (e) {}
  } else if (mode === 'canvas') {
    if (reader) reader.style.display = 'none';
    if (canvasView) canvasView.style.display = 'flex';
    if (frame) frame.style.display = 'none';
    if (fallback) fallback.style.display = 'none';
    if (tabReader) tabReader.classList.remove('active');
    if (tabCanvas) tabCanvas.classList.add('active');
    if (tabPdf) tabPdf.classList.remove('active');
    try { localStorage.setItem('prepclone-leftpane-mode', 'canvas'); } catch (e) {}
    if (typeof currentBook !== 'undefined' && typeof currentChapter !== 'undefined') {
      renderPdfPageOnCanvas(currentBook, currentChapter, currentPageNum);
    }
  } else {
    if (reader) reader.style.display = 'block';
    if (canvasView) canvasView.style.display = 'none';
    if (frame) frame.style.display = 'none';
    if (fallback) fallback.style.display = 'none';
    if (tabReader) tabReader.classList.add('active');
    if (tabCanvas) tabCanvas.classList.remove('active');
    if (tabPdf) tabPdf.classList.remove('active');
    try { localStorage.setItem('prepclone-leftpane-mode', 'reader'); } catch (e) {}
  }
}

// PDF.js Canvas Page Renderer
let currentPdfDoc = null;
let currentPdfUrl = null;
let canvasScale = 1.0;
let currentRenderingTask = null;

function localPdfPath(bookId, chIdx) {
  if (NCERT[bookId]) {
    const code = `${NCERT[bookId].code}${NCERT[bookId].base + chIdx}`;
    return `books/${bookId}/${code}.pdf`;
  }
  return ncertPdf(bookId, chIdx);
}

async function renderPdfPageOnCanvas(bookId, chIdx, pageNum) {
  const statusEl = document.getElementById('canvasStatusText');
  const canvas = document.getElementById('pdfCanvas');
  const overlay = document.getElementById('pdfHighlightOverlay');
  if (!canvas) return;

  const pdfUrl = localPdfPath(bookId, chIdx);
  if (statusEl) statusEl.textContent = `Rendering NCERT Page ${pageNum}...`;

  if (typeof window.pdfjsLib === 'undefined') {
    if (statusEl) statusEl.textContent = `PDF engine offline. Switch to 📖 NCERT Book for full content.`;
    return;
  }

  try {
    if (!currentPdfDoc || currentPdfUrl !== pdfUrl) {
      currentPdfUrl = pdfUrl;
      const loadingTask = window.pdfjsLib.getDocument({
        url: pdfUrl,
        disableAutoFetch: true,
        disableStream: false
      });
      currentPdfDoc = await loadingTask.promise;
    }

    const page = await currentPdfDoc.getPage(Math.min(pageNum, currentPdfDoc.numPages));
    const container = document.getElementById('pdfCanvasScroll');
    const containerWidth = container ? Math.max(320, container.clientWidth - 32) : 600;
    const unscaledViewport = page.getViewport({ scale: 1 });
    const fitScale = (containerWidth / unscaledViewport.width) * canvasScale;
    const viewport = page.getViewport({ scale: fitScale });

    const ctx = canvas.getContext('2d');
    canvas.height = viewport.height;
    canvas.width = viewport.width;
    canvas.style.width = `${viewport.width}px`;
    canvas.style.height = `${viewport.height}px`;

    if (overlay) {
      overlay.style.width = `${viewport.width}px`;
      overlay.style.height = `${viewport.height}px`;
    }

    if (currentRenderingTask) {
      try { currentRenderingTask.cancel(); } catch (e) {}
    }
    currentRenderingTask = page.render({
      canvasContext: ctx,
      viewport: viewport
    });
    await currentRenderingTask.promise;
    currentRenderingTask = null;
    if (statusEl) statusEl.textContent = `Page ${pageNum} of ${currentPdfDoc.numPages} · Official NCERT`;
  } catch (err) {
    if (err && err.name === 'RenderingCancelledException') return;
    console.warn('[PDF.js] Render fallback:', err);
    if (statusEl) statusEl.textContent = `Official NCERT textbook sheet available in 📖 Book View`;
  }
}

function zoomPdfCanvas(delta) {
  canvasScale = Math.max(0.5, Math.min(2.5, canvasScale + delta));
  const lbl = document.getElementById('canvasZoomPercent');
  if (lbl) lbl.textContent = `${Math.round(canvasScale * 100)}%`;
  renderPdfPageOnCanvas(currentBook, currentChapter, currentPageNum);
}

function fitPdfCanvas() {
  canvasScale = 1.0;
  const lbl = document.getElementById('canvasZoomPercent');
  if (lbl) lbl.textContent = `100%`;
  renderPdfPageOnCanvas(currentBook, currentChapter, currentPageNum);
}

function applySplitPref() {
  try {
    if (localStorage.getItem('prepclone-split') === 'off') {
      const w = document.getElementById('splitWrap');
      if (w) { w.classList.remove('split-on'); w.classList.add('split-off'); }
      const btn = document.querySelector('.pdf-toggle:not(.pdf-mode)');
      if (btn) btn.textContent = 'PDF';
    }
    const f = document.querySelector('.pdf-frame');
    const mb = document.querySelector('.pdf-mode');
    const mode = getPdfMode();
    const want = pdfSrcFor(mode, currentBook, currentChapter);
    if (f && f.getAttribute('src') !== want) f.src = want;
    if (mb) mb.textContent = PDF_MODE_LABEL[mode];

    const leftMode = localStorage.getItem('prepclone-leftpane-mode') || 'reader';
    switchLeftPaneView(leftMode);
  } catch (e) {}
}

function togglePdfMode() {
  const f = document.querySelector('.pdf-frame');
  const mb = document.querySelector('.pdf-mode');
  if (!f) return;
  const next = PDF_MODES[(PDF_MODES.indexOf(getPdfMode()) + 1) % PDF_MODES.length];
  try { localStorage.setItem('prepclone-pdfmode', next); } catch (e) {}
  f.src = pdfSrcFor(next, currentBook, currentChapter);
  if (mb) mb.textContent = PDF_MODE_LABEL[next];
}

function escapeHtml(str) {
  if (!str) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

function detectQuestionPattern(q) {
  if (!q) return 'mcq';
  if (q.type === 'AR' || /assertion.*reason/i.test(q.question) || /assertion\s*\(a\)/i.test(q.question) || /both\s+assertion\s+and\s+reason/i.test((q.options || []).join(' '))) {
    return 'ar';
  }
  if (q.type === 'statement' || /statement\s*i/i.test(q.question) || /statement\s+1/i.test(q.question) || /both\s+statement\s+i\s+and\s+statement\s+ii/i.test((q.options || []).join(' '))) {
    return 'statement';
  }
  if (q.type === 'match' || /match\s+(list|column)/i.test(q.question) || /column\s*i.*column\s*ii/i.test(q.question)) {
    return 'match';
  }
  return 'mcq';
}

function findBestSentence(paraText, qObj) {
  if (!paraText) return '';
  const rawSentences = paraText.match(/[^.!?]+(?:[.!?]+["']?|$)/g) || [paraText];
  const sentences = rawSentences.map(s => s.trim()).filter(s => s.length > 8);
  if (sentences.length <= 1) return sentences[0] || paraText;
  if (!qObj) return sentences[0];

  const stopWords = new Set(['the','a','an','and','or','but','in','on','at','to','for','of','with','by','from','up','about','into','over','after','is','are','was','were','be','been','being','have','has','had','do','does','did','will','would','shall','should','can','could','may','might','must','that','which','who','whom','this','these','those','what','when','where','why','how','all','any','both','each','few','more','most','other','some','such','no','nor','not','only','own','same','so','than','too','very','just']);

  const extractWords = (str) => {
    return (str || '').toLowerCase().replace(/[^a-z0-9\s]/g, ' ').split(/\s+/).filter(w => w.length > 2 && !stopWords.has(w));
  };

  const optLetter = qObj.answer || 'A';
  const optIdx = { 'A': 0, 'B': 1, 'C': 2, 'D': 3 }[optLetter.toUpperCase()] || 0;
  const correctOptText = (qObj.options && qObj.options[optIdx]) ? qObj.options[optIdx] : '';

  const qWords = extractWords(qObj.question);
  const aWords = extractWords(correctOptText);
  const expWords = extractWords(qObj.explanation);

  let bestSent = sentences[0];
  let maxScore = -1;

  sentences.forEach(s => {
    const sLower = s.toLowerCase();
    let score = 0;
    if (correctOptText && correctOptText.length > 10) {
      const frag = correctOptText.slice(0, 16).toLowerCase();
      if (sLower.includes(frag)) score += 20;
    }
    aWords.forEach(w => { if (sLower.includes(w)) score += 5; });
    qWords.forEach(w => { if (sLower.includes(w)) score += 2; });
    expWords.forEach(w => { if (sLower.includes(w)) score += 1; });

    if (score > maxScore) {
      maxScore = score;
      bestSent = s;
    }
  });

  return bestSent;
}

function highlightNcertParagraph(id, qIndex) {
  // If split pane was closed, open it
  const wrap = document.getElementById('splitWrap');
  if (wrap && wrap.classList.contains('split-off')) {
    toggleSplit();
  }

  // If in external iframe embed, switch to reader view so highlight is visible
  const leftMode = localStorage.getItem('prepclone-leftpane-mode') || 'reader';
  if (leftMode === 'pdf') {
    switchLeftPaneView('reader');
  }

  // Remove previous highlight in reader
  document.querySelectorAll('.ncert-para.ncert-highlight-active').forEach(p => {
    p.classList.remove('ncert-highlight-active');
  });

  // Reset any previously highlighted sentence markers
  document.querySelectorAll('.ncert-para-text[data-orig-text]').forEach(el => {
    el.textContent = el.dataset.origText;
  });

  // Try finding by exact id or by data-qidx
  let target = document.getElementById(`ncert-para-${id}`);
  if (!target && typeof qIndex !== 'undefined') {
    target = document.querySelector(`.ncert-para[data-qidx="${qIndex}"]`);
  }
  if (!target && typeof currentBook !== 'undefined') {
    target = document.getElementById(`ncert-para-${currentBook}_${currentChapter}_${currentPageNum}_${qIndex}`);
  }

  if (target) {
    target.classList.add('ncert-highlight-active');

    // Sentence-level marker highlighting
    const textEl = target.querySelector('.ncert-para-text');
    if (textEl) {
      if (!textEl.dataset.origText) {
        textEl.dataset.origText = textEl.textContent.trim();
      }
      const fullText = textEl.dataset.origText;

      let targetQ = null;
      const qNum = parseInt(qIndex, 10);
      const curQuestions = (window.currentChapterPages?.find(p => p.page === currentPageNum)?.questions) || [];
      if (!isNaN(qNum) && curQuestions[qNum]) {
        targetQ = curQuestions[qNum];
      } else if (String(qIndex).startsWith('pyq_')) {
        const pyqIdx = parseInt(String(qIndex).replace('pyq_', ''), 10);
        if (window.currentChapterPyqs && window.currentChapterPyqs[pyqIdx]) {
          targetQ = window.currentChapterPyqs[pyqIdx];
        }
      }

      const bestSent = findBestSentence(fullText, targetQ);
      if (bestSent && fullText.includes(bestSent)) {
        const parts = fullText.split(bestSent);
        if (parts.length >= 2) {
          textEl.innerHTML = escapeHtml(parts[0]) +
            `<mark class="ncert-sentence-marker sweep" id="marker-${id}" title="Exact NCERT Key Statement"><span class="marker-pen-icon">🖊️</span>${escapeHtml(bestSent)}</mark>` +
            escapeHtml(parts.slice(1).join(bestSent));
        }
      }
    }

    playTone('marker');
    target.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  // Also draw highlight on canvas overlay if in canvas mode
  const overlay = document.getElementById('pdfHighlightOverlay');
  if (overlay) {
    overlay.innerHTML = '';
    const qNum = parseInt(qIndex, 10) || 0;
    const box = document.createElement('div');
    box.className = 'pdf-canvas-highlight-rect';
    const topPct = Math.min(78, 10 + (qNum * 16));
    box.style.top = `${topPct}%`;
    box.style.height = '15%';
    box.style.left = '5%';
    box.style.width = '90%';
    overlay.appendChild(box);
    box.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
}

function toggleHintDropdown(id, qIndex, event) {
  if (event) event.stopPropagation();
  const dd = document.getElementById(`hint-dd-${id}`);
  const btn = document.getElementById(`hint-btn-${id}`);
  if (!dd) return;
  const willShow = !dd.classList.contains('show');
  dd.classList.toggle('show', willShow);
  if (btn) {
    btn.classList.toggle('active', willShow);
    btn.innerHTML = willShow ? '<span>💡</span> Hide Hint' : '<span>💡</span> Hint & NCERT Anchor';
  }
  if (willShow) {
    highlightNcertParagraph(id, qIndex);
  }
}

function focusQuestionCard(id) {
  const card = document.getElementById(`q-${id}`);
  if (card) {
    card.scrollIntoView({ behavior: 'smooth', block: 'center' });
    card.style.transition = 'box-shadow 0.3s ease, border-color 0.3s ease';
    card.style.borderColor = 'var(--accent-orange)';
    card.style.boxShadow = '0 0 0 3px rgba(245, 158, 11, 0.35)';
    setTimeout(() => {
      card.style.borderColor = '';
      card.style.boxShadow = '';
    }, 2200);
  }
}

function renderQuestion(q, id, isPyq, qIndex) {
  const labels = ['A','B','C','D'];
  const isStarred = getStarredSet().has(id);
  const qIdx = qIndex !== undefined ? qIndex : (id.split('_').pop() || 0);
  const pat = detectQuestionPattern(q);
  const patBadge = pat === 'ar' ? '<span class="q-pattern-badge badge-ar">⚡ Assertion-Reason</span>'
    : pat === 'statement' ? '<span class="q-pattern-badge badge-statement">📋 Statements</span>'
    : pat === 'match' ? '<span class="q-pattern-badge badge-match">🔗 Match-List</span>'
    : '<span class="q-pattern-badge badge-mcq">NCERT MCQ</span>';

  return `
    <div class="question-card" id="q-${id}" data-pattern="${pat}" data-diff="${(q.difficulty || 'Medium').toLowerCase()}" data-pyq="${(isPyq || 'book' in q) ? 1 : 0}" data-exam="${(q.exam || []).join(',').toLowerCase()}">
      <div class="q-meta">
        <span class="q-mcq">◉ MCQ</span>
        ${patBadge}
        <span class="q-type">${q.difficulty || 'MCQ'}</span>
        ${q.exam?.length ? `<span class="q-exam">${q.exam.join(', ')}</span>` : ''}
        ${q.year ? `<span class="q-year">📅 ${q.year}</span>` : ''}
        ${q.source ? `<a class="q-src" href="${q.source}" target="_blank" rel="noopener" title="Transcribed from this source page">🔗 ${q.sourceName || 'Source'}</a>` : ''}
        ${q.ncertRef ? `<span class="q-ncert" title="Maps to this NCERT paragraph">📖 ${q.ncertRef}</span>` : ''}
        <span class="q-timer-badge" id="qtimer-${id}">⏱️ <span id="qttime-${id}">0s</span><span class="qt-pacing-pill" id="qtpill-${id}" style="display:none"></span></span>
        <button class="star-btn ${isStarred ? 'active' : ''}" data-qid="${id}" onclick="toggleStar('${id}', event)" title="${isStarred ? 'Bookmarked' : 'Bookmark / Star question'}">${isStarred ? '★' : '☆'}</button>
      </div>
      <div class="q-text">${q.question}</div>
      <div class="options">
        ${q.options.map((opt, i) => `
          <div class="option" role="button" tabindex="0" data-qid="${id}" data-idx="${i}" onclick="selectAnswer('${id}', ${i}, '${q.answer}')">
            <div class="option-label">${labels[i]}</div>
            <div>${opt}</div>
          </div>
        `).join('')}
      </div>

      <div class="mistake-bucket-bar" id="mbb-${id}" style="${getQuestionMistakeBucket(id) ? 'display:flex' : 'display:none'}">
        <div class="mbb-header">
          <span class="mbb-label">🏷️ Categorize Mistake:</span>
          <span style="font-size:11px;color:var(--text-muted)">Saved to Notebook</span>
        </div>
        <div class="mbb-chips">
          <button type="button" class="bucket-chip bucket-silly ${getQuestionMistakeBucket(id) === 'silly' ? 'active' : ''}" onclick="setQuestionMistakeBucket('${id}', 'silly', event)">🟡 Silly Mistake</button>
          <button type="button" class="bucket-chip bucket-concept ${getQuestionMistakeBucket(id) === 'concept' ? 'active' : ''}" onclick="setQuestionMistakeBucket('${id}', 'concept', event)">🔴 Concept Trap</button>
          <button type="button" class="bucket-chip bucket-formula ${getQuestionMistakeBucket(id) === 'formula' ? 'active' : ''}" onclick="setQuestionMistakeBucket('${id}', 'formula', event)">🟣 Formula Slip</button>
          <button type="button" class="bucket-chip bucket-guess ${getQuestionMistakeBucket(id) === 'guess' ? 'active' : ''}" onclick="setQuestionMistakeBucket('${id}', 'guess', event)">⚪ Wild Guess</button>
        </div>
      </div>

      <div class="q-actions-bar">
        <button class="hint-btn" id="hint-btn-${id}" onclick="toggleHintDropdown('${id}', '${qIdx}', event)" title="View Hint & Highlight NCERT Source Paragraph">
          <span>💡</span> Hint & NCERT Anchor
        </button>
        <button class="show-ans" onclick="revealAnswer('${id}', '${q.answer}', this)">Show Answer ▼</button>
      </div>

      <div class="hint-dropdown" id="hint-dd-${id}">
        <div class="hint-dd-content">
          <div class="hint-dd-section">
            <div class="hint-dd-title">💡 Clue / Hint</div>
            <div class="hint-dd-body">${q.hint || 'Carefully review the highlighted paragraph in the left NCERT textbook page.'}</div>
          </div>
          <div class="hint-dd-section">
            <div class="hint-dd-title">📘 NCERT Conceptual Explanation</div>
            <div class="hint-dd-body">${q.explanation || ''}</div>
          </div>
          <div class="hint-dd-section">
            <div class="hint-dd-title">📖 NCERT Textbook Source Anchor</div>
            <div class="hint-dd-body">
              <span class="ref-badge">📍 ${q.ncertRef || 'NCERT Page Reference'}</span>
              <button class="btn-focus-para" onclick="highlightNcertParagraph('${id}', '${qIdx}')">Highlight on Left Page ↗</button>
            </div>
          </div>
        </div>
      </div>

      <div class="hint-box" id="hint-${id}" style="display:none">
        <details>
          <summary>💡 Hint</summary>
          <p>${q.hint || 'No hint available.'}</p>
        </details>
      </div>
      ${q.ncertPara ? `<div class="hint-box" style="display:none">
        <details>
          <summary>📖 NCERT source lines (${q.ncertRef})</summary>
          <p>${q.ncertPara}</p>
          ${q.conceptUrl ? `<p><a href="${q.conceptUrl}" target="_blank" rel="noopener" style="color:var(--accent-orange);font-weight:600">Open concept page with all linked PYQs →</a></p>` : ''}
        </details>
      </div>` : ''}

      <div class="explanation" id="exp-${id}">
        <strong>Answer: ${q.answer}</strong><br>
        ${q.explanation || ''}
      </div>
    </div>`;
}


function selectAnswer(qid, idx, correct) {
  try {
    const s = new Set(JSON.parse(localStorage.getItem('prepclone-progress') || '[]'));
    s.add(qid);
    localStorage.setItem('prepclone-progress', JSON.stringify([...s]));
  } catch (e) { /* private mode: progress just won't persist */ }
  const exp = document.getElementById(`exp-${qid}`);
  if (exp && exp.classList.contains('show')) return; // revealed: locked
  document.querySelectorAll(`.option[data-qid="${qid}"]`).forEach((opt) => opt.classList.remove('picked'));
  const chosen = document.querySelector(`.option[data-qid="${qid}"][data-idx="${idx}"]`);
  if (chosen) chosen.classList.add('picked');

  // Pacing tracking
  const correctIdx = correct.charCodeAt(0) - 65;
  const isCorrect = (idx === correctIdx);
  recordQuestionPacing(qid, isCorrect);

  // Automatically record mistake and show categorization bar if chosen option is incorrect
  if (!isCorrect) {
    const qObj = findQuestionById(qid);
    if (qObj) recordMistake(qObj, qid, idx);
    const mbb = document.getElementById(`mbb-${qid}`);
    if (mbb) mbb.style.display = 'flex';
  }
  playTone(isCorrect ? 'correct' : 'click');
  recordStudyActivity();
  recordDailyGoalAttempt();
  updatePageProgress();
}

function revealAnswer(qid, correct, btn) {
  const options = document.querySelectorAll(`.option[data-qid="${qid}"]`);
  const correctIdx = correct.charCodeAt(0) - 65;
  const exp = document.getElementById(`exp-${qid}`);
  if (!exp) return;
  const shown = exp.classList.toggle('show');
  options.forEach((opt, i) => {
    if (shown) {
      opt.style.pointerEvents = 'none';
      if (i === correctIdx) opt.classList.add('correct');
      else if (opt.classList.contains('picked')) {
        opt.classList.add('wrong');
        const qObj = findQuestionById(qid);
        if (qObj) recordMistake(qObj, qid, i);
        const mbb = document.getElementById(`mbb-${qid}`);
        if (mbb) mbb.style.display = 'flex';
      }
    } else {
      opt.style.pointerEvents = '';
      opt.classList.remove('correct', 'wrong');
    }
  });
  if (btn) btn.textContent = shown ? 'Hide Answer ▲' : 'Show Answer ▼';
}

function updatePageProgress() {
  const cards = document.querySelectorAll('#chapter-qs .question-card');
  const total = cards.length;
  let done = 0;
  try {
    const s = new Set(JSON.parse(localStorage.getItem('prepclone-progress') || '[]'));
    cards.forEach(c => { if (s.has(c.id.replace(/^q-/, ''))) done++; });
  } catch (e) {}
  const t = document.getElementById('pp-text');
  const f = document.getElementById('pp-fill');
  if (t) t.textContent = `${done}/${total}`;
  if (f) f.style.width = total ? (done / total * 100) + '%' : '0%';
}

function goPage(page) {
  currentPageNum = page;
  renderChapter();
}

function setQFilter(group, kind, el) {
  if (group === 'exam') {
    document.querySelectorAll('.echip').forEach(c => c.classList.remove('active'));
  } else if (group === 'diff') {
    document.querySelectorAll('.fchip').forEach(c => c.classList.remove('active'));
  } else if (group === 'pattern') {
    document.querySelectorAll('.pchip').forEach(c => c.classList.remove('active'));
  }
  el.classList.add('active');
  const exam = document.querySelector('.echip.active')?.dataset.k || 'all';
  const diff = document.querySelector('.fchip.active')?.dataset.k || 'all';
  const pat = document.querySelector('.pchip.active')?.dataset.k || 'all';
  document.querySelectorAll('#chapter-qs .question-card').forEach(card => {
    const examOk = exam === 'all' || (card.dataset.exam || '').split(',').includes(exam);
    const diffOk = diff === 'all' || (diff === 'pyq' ? card.dataset.pyq === '1' : card.dataset.diff === diff);
    const patOk = pat === 'all' || card.dataset.pattern === pat;
    card.style.display = (examOk && diffOk && patOk) ? '' : 'none';
  });

  const visibleCount = Array.from(document.querySelectorAll('#chapter-qs .question-card')).filter(c => c.style.display !== 'none').length;
  let emptyMsg = document.getElementById('no-filter-qs-msg');
  if (visibleCount === 0) {
    if (!emptyMsg) {
      emptyMsg = document.createElement('div');
      emptyMsg.id = 'no-filter-qs-msg';
      emptyMsg.className = 'empty-filter-state';
      emptyMsg.style.cssText = 'text-align:center;padding:32px 16px;color:var(--text-muted);background:var(--bg-card);border:1px dashed var(--border);border-radius:12px;margin:20px 0;';
      emptyMsg.innerHTML = '<div style="font-size:24px;margin-bottom:8px">📋</div><div style="font-weight:600">No questions on this page match the selected filter.</div><button class="btn-secondary btn-sm" style="margin-top:12px" onclick="resetFilters()">Reset All Filters</button>';
      document.getElementById('chapter-qs')?.appendChild(emptyMsg);
    }
  } else if (emptyMsg) {
    emptyMsg.remove();
  }
}

function resetFilters() {
  document.querySelector('.echip[data-k="all"]')?.click();
  document.querySelector('.fchip[data-k="all"]')?.click();
  document.querySelector('.pchip[data-k="all"]')?.click();
}

// ============ QUIZ ============
async function startQuiz() {
  await loadPyq();
  // Load every book so the pool spans the full bank, not just visited books
  await Promise.all(Object.keys(BOOKS).map(b => loadBookData(b)));
  // Pick 10 random questions from the full bank
  const allQuestions = [];
  Object.entries(questionData).forEach(([bookId, pages]) => {
    pages.forEach(p => {
      p.questions.forEach(q => {
        allQuestions.push({ ...q, bookId, chapter: p.chapter, topic: p.topic });
      });
    });
  });
  (pyqData || []).forEach(q => {
    if (questionData[q.book]) allQuestions.push({ ...q, bookId: q.book, topic: BOOKS[q.book].chapters[q.chapter] });
  });
  
  if (allQuestions.length === 0) {
    // No data available at all (e.g. offline data files missing)
    return;
  }
  
  // Shuffle and pick 10
  quizQuestions = allQuestions.sort(() => Math.random() - 0.5).slice(0, 10);
  quizIndex = 0;
  quizAnswers = new Array(quizQuestions.length).fill(null);
  quizTimeLeft = quizQuestions.length * 60;
  quizTimeUsed = 0;
  stopQuizTimer();
  quizTimer = setInterval(tickQuiz, 1000);
  currentPage = 'quiz';
  render();
}

function stopQuizTimer() {
  if (quizTimer) { clearInterval(quizTimer); quizTimer = null; }
}

function fmtTime(s) {
  s = Math.max(0, s);
  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
}

function tickQuiz() {
  quizTimeLeft--;
  quizTimeUsed++;
  const el = document.getElementById('quiz-timer');
  if (el) {
    el.textContent = fmtTime(quizTimeLeft);
    if (quizTimeLeft <= 60) el.classList.add('danger');
  }
  if (quizTimeLeft <= 0) showQuizResult();
}

const correctIdx = (q) => q.answer.charCodeAt(0) - 65;

function quizScoreLive() {
  let s = 0;
  quizAnswers.forEach((a, i) => {
    if (a === null || a === 'skip') return;
    s += (a === correctIdx(quizQuestions[i])) ? 4 : -1;
  });
  return s;
}

function renderQuiz() {
  if (quizQuestions.length === 0) {
    return `<section class="section" style="text-align:center">
      <h2>Loading quiz questions...</h2>
      <p style="color:var(--text-secondary)">Please wait while we load questions.</p>
    </section>`;
  }

  const q = quizQuestions[quizIndex];
  const labels = ['A','B','C','D'];
  const sel = quizAnswers[quizIndex];
  const done = quizAnswers.filter(a => a !== null).length;

  return `
    <section class="quiz-container">
      <div class="quiz-topbar">
        <div class="qtimer">⏱ <span id="quiz-timer">${fmtTime(quizTimeLeft)}</span></div>
        <div class="qscore">Score <b id="quiz-live">${quizScoreLive()}</b><span class="qmax"> / ${quizQuestions.length * 4}</span></div>
        <div class="qmark">+4 correct · −1 wrong</div>
      </div>
      <div class="quiz-header">
        <h1>Test Mode</h1>
        <p>Question ${quizIndex + 1} of ${quizQuestions.length} · ${done} attempted</p>
      </div>
      <div class="palette">
        ${quizQuestions.map((_, i) => {
          const a = quizAnswers[i];
          const cls = (i === quizIndex ? 'current ' : '') + (a === null ? '' : a === 'skip' ? 'skipped' : 'answered');
          return `<button class="pal-btn ${cls.trim()}" onclick="jumpQuiz(${i})">${i + 1}</button>`;
        }).join('')}
      </div>
      <div class="question-card">
        <div class="q-meta">
          <span class="q-type">${q.difficulty || 'MCQ'}</span>
          ${q.exam?.length ? `<span class="q-exam">${q.exam.join(', ')}</span>` : ''}
          ${q.year ? `<span class="q-year">📅 ${q.year}</span>` : ''}
          ${q.source ? `<a class="q-src" href="${q.source}" target="_blank" rel="noopener" title="Transcribed from this source page">🔗 ${q.sourceName || 'Source'}</a>` : ''}
        </div>
        <div class="q-text">${q.question}</div>
        <div class="options">
          ${q.options.map((opt, i) => `
            <div class="option ${sel === i ? 'picked' : ''}" onclick="selectQuizOption(${i})">
              <div class="option-label">${labels[i]}</div>
              <div>${opt}</div>
            </div>
          `).join('')}
        </div>
      </div>
      <div class="quiz-actions">
        <button class="btn-secondary" onclick="prevQuiz()" ${quizIndex === 0 ? 'disabled style="opacity:.4;pointer-events:none"' : ''}>← Prev</button>
        <button class="btn-secondary" onclick="skipQuiz()">Skip →</button>
        ${sel !== null && sel !== 'skip' ? '<button class="btn-secondary" onclick="clearQuiz()">Clear</button>' : ''}
        ${quizIndex < quizQuestions.length - 1 ? '<button class="btn-primary" onclick="nextQuiz()">Next →</button>' : ''}
        <button class="btn-primary" onclick="showQuizResult()">Submit Test</button>
      </div>
    </section>`;
}

function selectQuizOption(i) {
  quizAnswers[quizIndex] = i;
  document.querySelectorAll('.option').forEach((el, idx) => {
    if (idx === i) el.classList.add('picked');
    else el.classList.remove('picked');
  });
  const done = quizAnswers.filter(a => a !== null).length;
  const headerP = document.querySelector('.quiz-header p');
  if (headerP) headerP.innerHTML = `Question ${quizIndex + 1} of ${quizQuestions.length} &middot; ${done} attempted`;
  const palBtns = document.querySelectorAll('.pal-btn');
  if (palBtns[quizIndex]) palBtns[quizIndex].className = 'pal-btn current answered';
  const scoreLive = document.getElementById('quiz-live');
  if (scoreLive) scoreLive.innerText = quizScoreLive();
}

function jumpQuiz(i) {
  quizIndex = i;
  render();
}

function prevQuiz() {
  if (quizIndex > 0) { quizIndex--; render(); }
}

function nextQuiz() {
  if (quizIndex < quizQuestions.length - 1) { quizIndex++; render(); }
}

function skipQuiz() {
  quizAnswers[quizIndex] = 'skip';
  if (quizIndex < quizQuestions.length - 1) quizIndex++;
  render();
}

function clearQuiz() {
  quizAnswers[quizIndex] = null;
  document.querySelectorAll('.option').forEach(el => el.classList.remove('picked'));
  const done = quizAnswers.filter(a => a !== null).length;
  const headerP = document.querySelector('.quiz-header p');
  if (headerP) headerP.innerHTML = `Question ${quizIndex + 1} of ${quizQuestions.length} &middot; ${done} attempted`;
  const palBtns = document.querySelectorAll('.pal-btn');
  if (palBtns[quizIndex]) palBtns[quizIndex].className = 'pal-btn current';
  const scoreLive = document.getElementById('quiz-live');
  if (scoreLive) scoreLive.innerText = quizScoreLive();
}

function showQuizResult() {
  stopQuizTimer();
  const attempted = quizQuestions.filter((_, i) => quizAnswers[i] !== null && quizAnswers[i] !== 'skip').length;
  if (attempted > 0) recordDailyGoalAttempt(attempted);
  currentPage = 'quiz-result';
  render();
  window.scrollTo(0, 0);
}

function renderQuizResult() {
  let correct = 0, wrong = 0, skipped = 0;
  quizQuestions.forEach((q, i) => {
    const a = quizAnswers[i];
    if (a === null || a === 'skip') skipped++;
    else if (a === correctIdx(q)) correct++;
    else {
      wrong++;
      recordMistake(q, q.origId || `quiz_${i}`, a);
    }
  });
  const marks = correct * 4 - wrong;
  const max = quizQuestions.length * 4;
  const pct = Math.round(marks / max * 100);
  const labels = ['A','B','C','D'];
  return `
    <section class="quiz-container">
      <div class="question-card" style="text-align:center">
        <h1 style="font-size:48px;margin-bottom:8px">${marks} <span style="font-size:20px;color:var(--text-muted)">/ ${max}</span></h1>
        <h2 style="margin-bottom:8px">${correct} correct · ${wrong} wrong · ${skipped} skipped</h2>
        <p style="color:var(--text-secondary);margin-bottom:8px">Accuracy ${correct + wrong ? Math.round(correct / (correct + wrong) * 100) : 0}% · Time used ${fmtTime(quizTimeUsed)}</p>
        <p style="color:var(--text-secondary);margin-bottom:24px">
          ${pct >= 80 ? '🎉 Excellent! You really know your stuff!' :
            pct >= 60 ? '👍 Good job! Keep practicing!' :
            pct >= 40 ? '📚 Not bad, but review the chapters.' :
            '💪 Keep studying, you\'ll get there!'}
        </p>
        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
          <button class="btn-primary" onclick="startQuiz()">Try Again</button>
          <button class="btn-secondary" onclick="navigate('mix-quiz')">Try Mix Quiz (CBT)</button>
          <button class="btn-secondary" onclick="navigate('notebook')">View Mistakes Notebook</button>
          <button class="btn-secondary" onclick="navigate('books')">Browse Books</button>
        </div>
      </div>
      <h2 class="pyq-heading">📝 Review (${quizQuestions.length})</h2>
      ${quizQuestions.map((q, i) => {
        const a = quizAnswers[i];
        const ci = correctIdx(q);
        const qid = q.origId || `quiz_${i}`;
        const isStarred = getStarredSet().has(qid);
        const status = a === null || a === 'skip'
          ? '<span class="q-exam">skipped</span>'
          : a === ci ? '<span class="q-exam">+4 correct</span>' : '<span class="q-year">−1 wrong</span>';
        return `
        <div class="question-card">
          <div class="q-meta">
            <span class="q-type">Q${i + 1}</span>
            ${status}
            ${q.year ? `<span class="q-year">📅 ${q.year}</span>` : ''}
            ${q.ncertRef ? `<span class="q-ncert" title="Maps to this NCERT paragraph">📖 ${q.ncertRef}</span>` : ''}
            ${q.source ? `<a class="q-src" href="${q.source}" target="_blank" rel="noopener" title="Transcribed from this source page">🔗 ${q.sourceName || 'Source'}</a>` : ''}
            <button class="star-btn ${isStarred ? 'active' : ''}" onclick="toggleStar('${qid}', event)" title="Bookmark question">${isStarred ? '★' : '☆'}</button>
          </div>
          <div class="q-text">${q.question}</div>
          <div class="options" style="pointer-events:none">
            ${q.options.map((opt, j) => `
              <div class="option ${j === ci ? 'correct' : (j === a ? 'wrong' : '')}">
                <div class="option-label">${labels[j]}</div>
                <div>${opt}</div>
              </div>`).join('')}
          </div>
          <div class="explanation show">
            <strong>Answer: ${q.answer}</strong><br>
            ${q.explanation || ''}${a !== null && a !== 'skip' && a !== ci ? `<br><em>Your pick: ${labels[a]}</em>` : ''}
          </div>
        </div>`;
      }).join('')}
    </section>`;
}

// ============ PYQ HUB ============
function renderPyqs() {
  const card = (p) => `
    <div class="step-card">
      <h3>${p.name}</h3>
      <p>${p.desc}</p>
      <p style="margin-top:12px"><a class="btn-secondary" style="padding:8px 20px;display:inline-block" href="${p.url}" target="_blank" rel="noopener">Open PDF source →</a></p>
    </div>`;
  return `
    <section class="section" style="padding-top:100px">
      <div class="section-header">
        <h2 class="section-title">Previous Year Papers (PYQs)</h2>
        <span class="section-count">official NTA sources</span>
      </div>
      <p style="color:var(--text-secondary);font-size:14px;margin-bottom:24px">Official question papers hosted by NTA plus free compilations with answer keys. All links open the source sites directly — nothing is re-hosted here.</p>
      <h3 style="font-size:18px;margin-bottom:12px">🩺 NEET (UG)</h3>
      <div class="steps-grid" style="margin-bottom:32px">
        ${PYQS.neet.map(card).join('')}
      </div>
      <h3 style="font-size:18px;margin-bottom:12px">⚙️ JEE Main</h3>
      <div class="steps-grid">
        ${PYQS.jee.map(card).join('')}
      </div>
    </section>`;
}

// ============ MIX QUIZ / NEET CBT SIMULATOR ENGINE ============
